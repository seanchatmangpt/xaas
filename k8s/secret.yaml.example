apiVersion: v1
kind: Secret
metadata:
  name: xaas-secrets
  namespace: default
type: Opaque
stringData:
  SECRET_KEY_BASE: "REPLACE_ME_run: openssl rand -base64 48"
  DATABASE_URL: "ecto://REPLACE_ME_USER:REPLACE_ME_PASSWORD@postgres:5432/kanban_prod"
  POSTGRES_PASSWORD: "REPLACE_ME_same_password_as_DATABASE_URL"
  INTERNAL_API_TOKEN: "REPLACE_ME_run: openssl rand -hex 32"
  # Real gap found and fixed this session: config/runtime.exs requires
  # ONETIME_REVOKE_KEY (Xaas.Accounts.Token.RevokeVerifier's ash_onetime
  # HMAC key) and raises on boot if unset -- it was never in this example
  # template, and the live kind-xaas deployment's real secret didn't have
  # it either, so the pod crash-looped on the first real deploy attempt
  # after the ash migration. Same rotation discipline as the other keys.
  ONETIME_REVOKE_KEY: "REPLACE_ME_run: openssl rand -hex 32"
