apiVersion: v1
kind: Secret
metadata:
  name: xaas-secrets
  namespace: default
type: Opaque
stringData:
  SECRET_KEY_BASE: "REPLACE_ME_run: openssl rand -base64 48"
  DATABASE_URL: "ecto://REPLACE_ME_USER:REPLACE_ME_PASSWORD@postgres:5432/kanban_prod"
  POSTGRES_PASSWORD: "REPLACE_ME_same_password_as_DATABASE_URL"
  INTERNAL_API_TOKEN: "REPLACE_ME_run: openssl rand -hex 32"
