(define (domain xaas-sa2a-diataxis)
  (:requirements :typing :hierarchy)
  (:types subject)
  (:predicates
    (observed ?s - subject)
    (admitted ?s - subject)
    (selected ?s - subject)
    (constructed ?s - subject)
    (authorized ?s - subject)
    (done ?s - subject)
    (receipted ?s - subject)
    (replayed ?s - subject))

  (:task brce :parameters (?s - subject))
  (:method bounded-brce
    :parameters (?s - subject)
    :task (brce ?s)
    :ordered-subtasks (and
      (admit ?s)
      (select ?s)
      (construct ?s)
      (do ?s)
      (receipt ?s)
      (replay ?s)))

  (:action admit :parameters (?s - subject)
    :precondition (observed ?s)
    :effect (admitted ?s))
  (:action select :parameters (?s - subject)
    :precondition (admitted ?s)
    :effect (selected ?s))
  (:action construct :parameters (?s - subject)
    :precondition (selected ?s)
    :effect (constructed ?s))
  (:action do :parameters (?s - subject)
    :precondition (and (constructed ?s) (authorized ?s))
    :effect (done ?s))
  (:action receipt :parameters (?s - subject)
    :precondition (done ?s)
    :effect (receipted ?s))
  (:action replay :parameters (?s - subject)
    :precondition (receipted ?s)
    :effect (replayed ?s)))
