// in instrumentation/alloy/local.alloy

discovery.docker "xaas" {
  host = "unix:///var/run/docker.sock"
  refresh_interval = "15s"

  filter {
    name = "status"
    values = ["running"]
  }

  filter {
    name = "name"
    values = ["web"]
  }
}

discovery.relabel "use_container_name_not_docker_ip" {
  targets = discovery.docker.xaas.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex = "/(.*)"
    target_label = "instance"
  }
}

prometheus.remote_write "xaas" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}

prometheus.scrape "xaas" {
  targets    = discovery.relabel.use_container_name_not_docker_ip.output
  forward_to = [prometheus.remote_write.xaas.receiver]
  scrape_interval = "5s"
  scrape_timeout = "5s"
}
