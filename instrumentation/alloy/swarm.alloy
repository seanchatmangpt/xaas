discovery.dockerswarm "xaas" {
  host = "unix:///var/run/docker.sock"
  role = "tasks"
  refresh_interval = "15s"

  filter {
    name = "desired-state"
    values = ["running", "accepted"]
  }

  filter {
    name = "service"
    values = ["xaas_web"]
  }
}

discovery.relabel "use_swarm_node_not_internal_ip" {
  targets = discovery.dockerswarm.xaas.targets

  rule {
    source_labels = ["__meta_dockerswarm_node_id"]
    target_label = "instance"
  }
}

prometheus.remote_write "xaas" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}

prometheus.scrape "xaas" {
  targets    = discovery.relabel.use_swarm_node_not_internal_ip.output
  forward_to = [prometheus.remote_write.xaas.receiver]
  scrape_interval = "5s"
  scrape_timeout = "5s"
}

