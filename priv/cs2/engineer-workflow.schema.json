    "projection": {"const": "engineer-workflow"},
    "authority_ceiling": {"const": "construct"},
    "evidence": {"type": "array"},
    "provenance": {"type": "object"},
    "triage": {"type": "object"}
  },
  "additionalProperties": true
}
