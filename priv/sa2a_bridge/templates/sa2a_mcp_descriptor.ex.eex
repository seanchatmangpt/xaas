<%= for row <- capabilities do %>    "<%= row["capabilityId"] %>" => %{order: <%= row["capabilityOrder"] %>, exposed_via: "<%= row["exposedVia"] %>", name: "<%= row["capabilityName"] %>", description: "<%= row["capabilityDescription"] %>", observation_scope: "<%= row["observationScope"] %>", mutation_scope: "<%= row["mutationScope"] %>", requires_authority?: <%= row["requiresAuthority"] %>, reversible?: <%= row["isReversible"] %>, receipt_semantics: "<%= row["receiptSemantics"] %>"},
