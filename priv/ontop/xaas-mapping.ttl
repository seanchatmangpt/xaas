@prefix rr:      <http://www.w3.org/ns/r2rml#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix org:     <http://www.w3.org/ns/org#> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix schema:  <https://schema.org/> .

# XAAS public-ontology projection for real Postgres tables exposed by Ontop.
# Classes and predicates are public vocabularies. XAAS-owned URNs identify
# concrete application instances; they are identifiers, not a private ontology.
#
# Canonical executable semantics live in Ash resources. This R2RML file is a
# read projection for Ontop/SPARQL interoperability. It acquires no execution
# authority and is never an actuation path.
#
# Referential-integrity disclosure preserved from the original prototype:
# billing_subscriptions.org_id, marketplace_providers.org_id and
# platform_webhooks.org_id are text values containing orgs.slug and are enforced
# by the application rather than a PostgreSQL FK. Other referencing-object maps
# below use real database FKs where documented by the schema.
#
# Deliberately NOT mapped: org_memberships.user_id -> users.id. Users are an
# authentication/PII-bearing resource and the Ontop endpoint does not execute
# per-actor Ash policies. Public semantic projection is not exposure authority.

<#OrgsTriplesMap>
  a rr:TriplesMap ;
  rr:logicalTable [ rr:tableName "orgs" ] ;
  rr:subjectMap [
    rr:template "urn:xaas:resource:org:{slug}" ;
    rr:class org:Organization ;
    rr:class prov:Agent
  ] ;
  rr:predicateObjectMap [
    rr:predicate dcterms:identifier ;
    rr:objectMap [ rr:column "id" ; rr:datatype xsd:string ; rr:termType rr:Literal ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate schema:name ;
    rr:objectMap [ rr:column "name" ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate skos:notation ;
    rr:objectMap [ rr:column "slug" ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate dcterms:type ;
    rr:objectMap [ rr:column "status" ]
  ] .

<#BillingSubscriptionsTriplesMap>
  a rr:TriplesMap ;
  rr:logicalTable [ rr:tableName "billing_subscriptions" ] ;
  rr:subjectMap [
    rr:template "urn:xaas:resource:subscription:{id}" ;
    rr:class schema:Service
  ] ;
  rr:predicateObjectMap [
    rr:predicate skos:notation ;
    rr:objectMap [ rr:column "tier" ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate dcterms:type ;
    rr:objectMap [ rr:column "status" ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate dcterms:identifier ;
    rr:objectMap [ rr:column "stripe_customer_id" ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate schema:endDate ;
    rr:objectMap [ rr:column "current_period_end" ; rr:datatype xsd:dateTime ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate org:organization ;
    rr:objectMap [
      rr:template "urn:xaas:resource:org:{org_id}" ;
      rr:termType rr:IRI
    ]
  ] .

<#MarketplaceProvidersTriplesMap>
  a rr:TriplesMap ;
  rr:logicalTable [ rr:tableName "marketplace_providers" ] ;
  rr:subjectMap [
    rr:template "urn:xaas:resource:provider:{id}" ;
    rr:class schema:Organization ;
    rr:class prov:Agent
  ] ;
  rr:predicateObjectMap [
    rr:predicate schema:name ;
    rr:objectMap [ rr:column "name" ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate skos:notation ;
    rr:objectMap [ rr:column "slug" ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate dcterms:type ;
    rr:objectMap [ rr:column "status" ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate org:organization ;
    rr:objectMap [
      rr:template "urn:xaas:resource:org:{org_id}" ;
      rr:termType rr:IRI
    ]
  ] .

<#PlatformWebhooksTriplesMap>
  a rr:TriplesMap ;
  rr:logicalTable [ rr:tableName "platform_webhooks" ] ;
  rr:subjectMap [
    rr:template "urn:xaas:resource:webhook:{id}" ;
    rr:class schema:EntryPoint
  ] ;
  rr:predicateObjectMap [
    rr:predicate schema:url ;
    rr:objectMap [ rr:column "url" ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate rdf:value ;
    rr:objectMap [ rr:column "enabled" ; rr:datatype xsd:boolean ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate org:organization ;
    rr:objectMap [
      rr:template "urn:xaas:resource:org:{org_id}" ;
      rr:termType rr:IRI
    ]
  ] .

<#PlatformWebhookDeliveriesTriplesMap>
  a rr:TriplesMap ;
  rr:logicalTable [ rr:tableName "platform_webhook_deliveries" ] ;
  rr:subjectMap [
    rr:template "urn:xaas:resource:webhook-delivery:{id}" ;
    rr:class prov:Activity
  ] ;
  rr:predicateObjectMap [
    rr:predicate dcterms:type ;
    rr:objectMap [ rr:column "event_type" ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate prov:value ;
    rr:objectMap [ rr:column "status" ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate schema:position ;
    rr:objectMap [ rr:column "attempt_count" ; rr:datatype xsd:integer ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate dcterms:relation ;
    rr:objectMap [
      rr:template "urn:xaas:resource:webhook:{webhook_id}" ;
      rr:termType rr:IRI
    ]
  ] .

<#ApprovalProviderStatusChangesTriplesMap>
  a rr:TriplesMap ;
  rr:logicalTable [ rr:tableName "approval_provider_status_changes" ] ;
  rr:subjectMap [
    rr:template "urn:xaas:resource:provider-status-change:{id}" ;
    rr:class prov:Activity ;
    rr:class odrl:Agreement
  ] ;
  rr:predicateObjectMap [
    rr:predicate dcterms:creator ;
    rr:objectMap [ rr:column "requested_by" ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate dcterms:type ;
    rr:objectMap [ rr:column "requested_status" ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate dcterms:contributor ;
    rr:objectMap [ rr:column "approved_by" ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate dcterms:subject ;
    rr:objectMap [
      rr:template "urn:xaas:resource:provider:{provider_id}" ;
      rr:termType rr:IRI
    ]
  ] .

<#ApprovalDrFailoversTriplesMap>
  a rr:TriplesMap ;
  rr:logicalTable [ rr:tableName "approval_dr_failovers" ] ;
  rr:subjectMap [
    rr:template "urn:xaas:resource:dr-failover:{id}" ;
    rr:class prov:Activity ;
    rr:class odrl:Agreement
  ] ;
  rr:predicateObjectMap [
    rr:predicate dcterms:creator ;
    rr:objectMap [ rr:column "requested_by" ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate dcterms:contributor ;
    rr:objectMap [ rr:column "approved_by" ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate schema:fromLocation ;
    rr:objectMap [ rr:column "from_region" ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate schema:toLocation ;
    rr:objectMap [ rr:column "to_region" ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate org:organization ;
    rr:objectMap [
      rr:template "urn:xaas:resource:org:{org_id}" ;
      rr:termType rr:IRI
    ]
  ] .

<#OrgMembershipsTriplesMap>
  a rr:TriplesMap ;
  rr:logicalTable [ rr:tableName "org_memberships" ] ;
  rr:subjectMap [
    rr:template "urn:xaas:resource:org-membership:{id}" ;
    rr:class org:Membership
  ] ;
  rr:predicateObjectMap [
    rr:predicate schema:roleName ;
    rr:objectMap [ rr:column "role" ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate org:organization ;
    rr:objectMap [
      rr:parentTriplesMap <#OrgsTriplesMap> ;
      rr:joinCondition [
        rr:child "org_id" ;
        rr:parent "id"
      ]
    ]
  ] .
