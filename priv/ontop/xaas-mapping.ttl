@prefix rr:   <http://www.w3.org/ns/r2rml#> .
@prefix rml:  <http://semweb.mmlab.be/ns/rml#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix xv:   <http://xaas.local/vocab#> .
@prefix xres: <http://xaas.local/resource/> .

# ---------------------------------------------------------------------------
# Real R2RML mapping for 4 real, already-existing xaas tables (confirmed via
# psql against the real kanban_dev database, docker-compose service `db`,
# 2026-08-20):
#
#   orgs                          (1 real row: slug "read-12")
#   billing_subscriptions.org_id  -> orgs.slug   (real, app-enforced FK; no
#                                                  DB-level FK constraint
#                                                  exists on this column --
#                                                  disclosed below)
#   marketplace_providers.org_id  -> orgs.slug   (same, app-enforced)
#   platform_webhooks.org_id      -> orgs.slug   (same, app-enforced)
#   platform_webhook_deliveries.webhook_id -> platform_webhooks.id
#                                                  (real DB-level FK,
#                                                   platform_webhook_deliveries_webhook_id_fkey)
#
# Disclosed gap: billing_subscriptions.org_id, marketplace_providers.org_id,
# and platform_webhooks.org_id are `text` columns holding the org *slug*,
# with no Postgres-level FOREIGN KEY constraint to orgs.slug (confirmed via
# `\d billing_subscriptions` / `\d platform_webhooks` -- only
# platform_webhook_deliveries has a real FK). The join below is a real,
# valid R2RML join condition regardless -- R2RML joins are expressed at the
# mapping level, not read off DB constraints -- but the *referential
# integrity* of that join is app-enforced only, not DB-enforced. Worth
# fixing with a real FK constraint if this prototype is promoted.
#
# 2026-08-20, extension: 3 more real tables added, all confirmed via psql
# `\d` against the real kanban_dev database (same discipline as above),
# chosen to prefer real DB-level FK constraints over app-enforced-only:
#
#   approval_provider_status_changes.provider_id -> marketplace_providers.id
#     (real DB FK `approval_provider_status_changes_provider_id_fkey`) --
#     the real maker-checker provider-approval lifecycle landed this
#     session (Xaas.Marketplace.ApprovalProviderStatusChange).
#   approval_dr_failovers.org_id -> orgs.slug
#     (real DB FK `approval_dr_failovers_org_id_fkey`, ON UPDATE CASCADE /
#     ON DELETE RESTRICT) -- one of the 3 real multitenancy FKs landed this
#     session (`20260821034020_add_org_fk_dr_failover_legal_hold_release_
#     deployment_quarantine.exs`); picked over its 2 siblings
#     (approval_deployment_quarantines, approval_legal_hold_releases) as
#     the representative real example -- same FK shape, same join
#     mechanics, not separately mapped here to avoid 3 near-duplicate
#     TriplesMaps for one disclosed pattern.
#   org_memberships.org_id -> orgs.id
#     (real DB FK `org_memberships_org_id_fkey`). Unlike the other org_id
#     columns in this file, this one is a real `uuid` referencing
#     `orgs.id`, not the `text` slug the OrgsTriplesMap subject IRI is
#     templated on -- so this edge uses a real R2RML referencing object
#     map (`rr:parentTriplesMap` + `rr:joinCondition`) instead of a
#     `rr:template` guess, which would have produced a wrong IRI (id where
#     the subject template expects slug). This is the more R2RML-correct
#     technique in general; the earlier edges above use the simpler
#     template form because their join column already equals the parent's
#     template column verbatim.
#
#   Deliberately NOT mapped: org_memberships.user_id -> users.id. `users`
#   is one of the 2 real auth/PII resources (`Xaas.Accounts.User`)
#   deliberately left unwired from the customer-facing HTTP API per
#   `docs/claude/diataxis/reference/http-api-surface.md` and this project's
#   CLAUDE.md ("never blindly wire routes on sensitive resources"). Same
#   discipline applies here: mapping `users` into the SPARQL graph would
#   expose PII-bearing rows through a datalayer with no per-actor Ash
#   policy enforcement (see this file's own "Still NOT resolved" section
#   below) -- a real, explicit access-control design for that table would
#   need to happen first, not mechanical generation. `org_memberships`
#   itself is still mapped (role + real org edge); only the user edge is
#   excluded.
# ---------------------------------------------------------------------------

<#OrgsTriplesMap>
  a rr:TriplesMap ;
  rr:logicalTable [ rr:tableName "orgs" ] ;
  rr:subjectMap [
    rr:template "http://xaas.local/resource/org/{slug}" ;
    rr:class xv:Org ;
  ] ;
  rr:predicateObjectMap [
    rr:predicate xv:orgId ;
    rr:objectMap [ rr:column "id" ; rr:datatype xsd:string ; rr:termType rr:Literal ] ;
  ] ;
  rr:predicateObjectMap [
    rr:predicate xv:name ;
    rr:objectMap [ rr:column "name" ] ;
  ] ;
  rr:predicateObjectMap [
    rr:predicate xv:slug ;
    rr:objectMap [ rr:column "slug" ] ;
  ] ;
  rr:predicateObjectMap [
    rr:predicate xv:status ;
    rr:objectMap [ rr:column "status" ] ;
  ] .

<#BillingSubscriptionsTriplesMap>
  a rr:TriplesMap ;
  rr:logicalTable [ rr:tableName "billing_subscriptions" ] ;
  rr:subjectMap [
    rr:template "http://xaas.local/resource/subscription/{id}" ;
    rr:class xv:Subscription ;
  ] ;
  rr:predicateObjectMap [
    rr:predicate xv:tier ;
    rr:objectMap [ rr:column "tier" ] ;
  ] ;
  rr:predicateObjectMap [
    rr:predicate xv:status ;
    rr:objectMap [ rr:column "status" ] ;
  ] ;
  rr:predicateObjectMap [
    rr:predicate xv:stripeCustomerId ;
    rr:objectMap [ rr:column "stripe_customer_id" ] ;
  ] ;
  rr:predicateObjectMap [
    rr:predicate xv:currentPeriodEnd ;
    rr:objectMap [ rr:column "current_period_end" ; rr:datatype xsd:dateTime ] ;
  ] ;
  # Graph edge: subscription -> org, via app-enforced org_id (= orgs.slug).
  rr:predicateObjectMap [
    rr:predicate xv:belongsToOrg ;
    rr:objectMap [
      rr:template "http://xaas.local/resource/org/{org_id}" ;
      rr:termType rr:IRI ;
    ] ;
  ] .

<#MarketplaceProvidersTriplesMap>
  a rr:TriplesMap ;
  rr:logicalTable [ rr:tableName "marketplace_providers" ] ;
  rr:subjectMap [
    rr:template "http://xaas.local/resource/provider/{id}" ;
    rr:class xv:MarketplaceProvider ;
  ] ;
  rr:predicateObjectMap [
    rr:predicate xv:name ;
    rr:objectMap [ rr:column "name" ] ;
  ] ;
  rr:predicateObjectMap [
    rr:predicate xv:slug ;
    rr:objectMap [ rr:column "slug" ] ;
  ] ;
  rr:predicateObjectMap [
    rr:predicate xv:status ;
    rr:objectMap [ rr:column "status" ] ;
  ] ;
  # Graph edge: provider -> org, via app-enforced org_id (= orgs.slug).
  rr:predicateObjectMap [
    rr:predicate xv:belongsToOrg ;
    rr:objectMap [
      rr:template "http://xaas.local/resource/org/{org_id}" ;
      rr:termType rr:IRI ;
    ] ;
  ] .

<#PlatformWebhooksTriplesMap>
  a rr:TriplesMap ;
  rr:logicalTable [ rr:tableName "platform_webhooks" ] ;
  rr:subjectMap [
    rr:template "http://xaas.local/resource/webhook/{id}" ;
    rr:class xv:Webhook ;
  ] ;
  rr:predicateObjectMap [
    rr:predicate xv:url ;
    rr:objectMap [ rr:column "url" ] ;
  ] ;
  rr:predicateObjectMap [
    rr:predicate xv:enabled ;
    rr:objectMap [ rr:column "enabled" ; rr:datatype xsd:boolean ] ;
  ] ;
  # Graph edge: webhook -> org, via app-enforced org_id (= orgs.slug).
  rr:predicateObjectMap [
    rr:predicate xv:belongsToOrg ;
    rr:objectMap [
      rr:template "http://xaas.local/resource/org/{org_id}" ;
      rr:termType rr:IRI ;
    ] ;
  ] .

<#PlatformWebhookDeliveriesTriplesMap>
  a rr:TriplesMap ;
  rr:logicalTable [ rr:tableName "platform_webhook_deliveries" ] ;
  rr:subjectMap [
    rr:template "http://xaas.local/resource/delivery/{id}" ;
    rr:class xv:WebhookDelivery ;
  ] ;
  rr:predicateObjectMap [
    rr:predicate xv:eventType ;
    rr:objectMap [ rr:column "event_type" ] ;
  ] ;
  rr:predicateObjectMap [
    rr:predicate xv:deliveryStatus ;
    rr:objectMap [ rr:column "status" ] ;
  ] ;
  rr:predicateObjectMap [
    rr:predicate xv:attemptCount ;
    rr:objectMap [ rr:column "attempt_count" ; rr:datatype xsd:integer ] ;
  ] ;
  # Graph edge: delivery -> webhook, via a real DB-level FK
  # (platform_webhook_deliveries_webhook_id_fkey -> platform_webhooks.id).
  rr:predicateObjectMap [
    rr:predicate xv:forWebhook ;
    rr:objectMap [
      rr:template "http://xaas.local/resource/webhook/{webhook_id}" ;
      rr:termType rr:IRI ;
    ] ;
  ] .

# ---------------------------------------------------------------------------
# Extension (2026-08-20): 3 more real tables, see header disclosure above.
# ---------------------------------------------------------------------------

<#ApprovalProviderStatusChangesTriplesMap>
  a rr:TriplesMap ;
  rr:logicalTable [ rr:tableName "approval_provider_status_changes" ] ;
  rr:subjectMap [
    rr:template "http://xaas.local/resource/provider-status-change/{id}" ;
    rr:class xv:ProviderStatusChange ;
  ] ;
  rr:predicateObjectMap [
    rr:predicate xv:requestedBy ;
    rr:objectMap [ rr:column "requested_by" ] ;
  ] ;
  rr:predicateObjectMap [
    rr:predicate xv:requestedStatus ;
    rr:objectMap [ rr:column "requested_status" ] ;
  ] ;
  rr:predicateObjectMap [
    rr:predicate xv:approvedBy ;
    rr:objectMap [ rr:column "approved_by" ] ;
  ] ;
  # Graph edge: provider-status-change -> provider, via a real DB-level FK
  # (approval_provider_status_changes_provider_id_fkey -> marketplace_providers.id).
  rr:predicateObjectMap [
    rr:predicate xv:forProvider ;
    rr:objectMap [
      rr:template "http://xaas.local/resource/provider/{provider_id}" ;
      rr:termType rr:IRI ;
    ] ;
  ] .

<#ApprovalDrFailoversTriplesMap>
  a rr:TriplesMap ;
  rr:logicalTable [ rr:tableName "approval_dr_failovers" ] ;
  rr:subjectMap [
    rr:template "http://xaas.local/resource/dr-failover/{id}" ;
    rr:class xv:DrFailover ;
  ] ;
  rr:predicateObjectMap [
    rr:predicate xv:requestedBy ;
    rr:objectMap [ rr:column "requested_by" ] ;
  ] ;
  rr:predicateObjectMap [
    rr:predicate xv:approvedBy ;
    rr:objectMap [ rr:column "approved_by" ] ;
  ] ;
  rr:predicateObjectMap [
    rr:predicate xv:fromRegion ;
    rr:objectMap [ rr:column "from_region" ] ;
  ] ;
  rr:predicateObjectMap [
    rr:predicate xv:toRegion ;
    rr:objectMap [ rr:column "to_region" ] ;
  ] ;
  # Graph edge: dr-failover -> org, via a real DB-level FK
  # (approval_dr_failovers_org_id_fkey -> orgs.slug, ON UPDATE CASCADE /
  # ON DELETE RESTRICT).
  rr:predicateObjectMap [
    rr:predicate xv:belongsToOrg ;
    rr:objectMap [
      rr:template "http://xaas.local/resource/org/{org_id}" ;
      rr:termType rr:IRI ;
    ] ;
  ] .

<#OrgMembershipsTriplesMap>
  a rr:TriplesMap ;
  rr:logicalTable [ rr:tableName "org_memberships" ] ;
  rr:subjectMap [
    rr:template "http://xaas.local/resource/org-membership/{id}" ;
    rr:class xv:OrgMembership ;
  ] ;
  rr:predicateObjectMap [
    rr:predicate xv:role ;
    rr:objectMap [ rr:column "role" ] ;
  ] ;
  # Graph edge: org-membership -> org, via a real DB-level FK
  # (org_memberships_org_id_fkey -> orgs.id). Uses a real R2RML referencing
  # object map (parent triples map + join condition) rather than a
  # rr:template, because org_memberships.org_id holds orgs.id (uuid), not
  # the orgs.slug the OrgsTriplesMap subject IRI is templated on -- Ontop
  # rewrites this into a real SQL join on orgs.id and emits the parent's
  # real slug-templated subject IRI.
  rr:predicateObjectMap [
    rr:predicate xv:belongsToOrg ;
    rr:objectMap [
      rr:parentTriplesMap <#OrgsTriplesMap> ;
      rr:joinCondition [
        rr:child "org_id" ;
        rr:parent "id" ;
      ] ;
    ] ;
  ] .
  # Deliberately NOT mapped: org_memberships.user_id -> users.id (real
  # auth/PII resource, deliberately unwired -- see header disclosure).
