@prefix rx: <https://ggen-igniter.dev/ontology/reactor-scaffold#> .

# Falsifier for ULTRACODE-50 Semantic Manufacture Closure, Reactor-DSL layer.
# Models the real Xaas.Ultracode.EpochReactor 6-step DAG (observe/admit/plan/
# construct/verify/receipt) as reactor-scaffold-pack rx: individuals, reusing
# ggen_igniter's own already-proven, already-tested plain-`Reactor` generation
# template (priv/ggen/reactor-scaffold-pack/templates/reactor.ex.eex) rather
# than inventing a new one. SCRATCH module name -- does not touch the real
# Xaas.Ultracode.EpochReactor.

rx:probe_epoch_reactor a rx:ReactorDef ;
    rx:moduleName "Xaas.Ultracode.Probe.EpochReactor" ;
    rx:inputs "epoch_id" ;
    rx:returnStep "receipt" .

rx:step_observe a rx:Step ;
    rx:order "1" ;
    rx:name "observe" ;
    rx:arguments "argument :epoch_id, input(:epoch_id)" ;
    rx:runBody "fn %{epoch_id: epoch_id}, _context ->\n      case Ash.get(Xaas.Ultracode.Epoch, epoch_id, load: [:run]) do\n        {:ok, epoch} -> {:ok, epoch}\n        {:error, error} -> {:error, {:observe_failed, error}}\n      end\n    end" ;
    rx:async "false" .

rx:step_admit a rx:Step ;
    rx:order "2" ;
    rx:name "admit" ;
    rx:arguments "argument :epoch, result(:observe)" ;
    rx:runBody "fn %{epoch: epoch}, _context ->\n      if epoch.state in [:expected, :running] do\n        {:ok, epoch}\n      else\n        {:error, {:refused, :epoch_not_admissible, epoch.state}}\n      end\n    end" ;
    rx:async "false" .

rx:step_plan a rx:Step ;
    rx:order "3" ;
    rx:name "plan" ;
    rx:arguments "argument :epoch, result(:admit)" ;
    rx:runBody "fn %{epoch: epoch}, _context ->\n      next_action = if epoch.state == :expected, do: :start, else: :complete\n      {:ok, next_action}\n    end" ;
    rx:async "false" .

rx:step_construct a rx:Step ;
    rx:order "4" ;
    rx:name "construct" ;
    rx:arguments "argument :epoch, result(:admit)\n    argument :next_action, result(:plan)" ;
    rx:runBody "fn %{epoch: epoch, next_action: next_action}, _context ->\n      Ash.update(epoch, %{}, action: next_action)\n    end" ;
    rx:async "false" .

rx:step_verify a rx:Step ;
    rx:order "5" ;
    rx:name "verify" ;
    rx:arguments "argument :epoch, result(:construct)\n    argument :next_action, result(:plan)" ;
    rx:runBody "fn %{epoch: epoch, next_action: next_action}, _context ->\n      expected_state = if next_action == :start, do: :running, else: :completed\n      case Ash.get(Xaas.Ultracode.Epoch, epoch.id) do\n        {:ok, %{state: ^expected_state}} -> {:ok, :alive}\n        {:ok, _mismatched} -> {:ok, :build_broken}\n        {:error, error} -> {:error, {:verify_failed, error}}\n      end\n    end" ;
    rx:async "false" .

rx:step_receipt a rx:Step ;
    rx:order "6" ;
    rx:name "receipt" ;
    rx:arguments "argument :epoch, result(:construct)\n    argument :outcome, result(:verify)" ;
    rx:runBody "fn %{epoch: epoch, outcome: outcome}, _context ->\n      Xaas.Ultracode.Receipt\n      |> Ash.Changeset.for_create(:seal, %{\n        epoch_id: epoch.id,\n        subject: epoch.exact_subject,\n        outcome: outcome,\n        sealed_at: DateTime.utc_now()\n      })\n      |> Ash.create()\n    end" ;
    rx:async "false" .
