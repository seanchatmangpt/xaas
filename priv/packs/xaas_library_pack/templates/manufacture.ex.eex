      target_module: "<%= row["targetModule"] %>",
      domain_module: "<%= row["domainModule"] %>",
      resource_module: "<%= row["resourceModule"] %>",
      mix_args: "<%= row["mixArgs"] %>"
    },
<% end %>
  ]

  @impl Mix.Task
  def run(args) do
    {opts, _rest, _invalid} =
      OptionParser.parse(args,
        strict: [phase: :string, yes: :boolean],
        aliases: [p: :phase, y: :yes]
      )

    phase = opts[:phase] || "all"
