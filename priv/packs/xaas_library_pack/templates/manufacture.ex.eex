    Mix.shell().info("[xaas.library.manufacture] Running phase: #{phase} (yes=#{yes?})")

    case phase do
      "base" ->
        run_base_phase(yes?)

      "core" ->
        run_core_phase(yes?)

      "all" ->
        run_base_phase(yes?)
        run_core_phase(yes?)

      other ->
        Mix.raise("Unknown phase: #{other}. Expected: base, core, all")
    end
