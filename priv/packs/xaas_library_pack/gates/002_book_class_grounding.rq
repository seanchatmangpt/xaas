PREFIX bibo: <http://purl.org/ontology/bibo/>
PREFIX schema: <https://schema.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xl: <https://ggen.io/ontology/xaas-library#>

SELECT ?bookClass WHERE {
  xl:Book a ?type ;
          rdfs:subClassOf bibo:Book, schema:Book .
  BIND(xl:Book AS ?bookClass)
}

