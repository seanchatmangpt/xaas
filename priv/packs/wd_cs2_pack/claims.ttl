# ---------------------------------------------------------------- claims

wdc:C01 a cs:Claim ; cs:claimId "C01" ; cs:claimOf wdcs2:case ;
  cs:claimText "The HDD failure-analysis agent is designed as a governed quality loop, not a chatbot in front of a vector database." ;
  cs:standing "DESIGN" ; cs:evidenceCeiling "DESIGN_DOCUMENT" ; cs:authorityCeiling "NONE" ;
  cs:supportedBy wde:E01 ; cs:falsifiedBy wdf:F01 ; cs:renderedBy wddeck:slide-01 .

wdc:C02 a cs:Claim ; cs:claimId "C02" ; cs:claimOf wdcs2:case ;
  cs:claimText "The dominant FA cost is repeated human reconstruction of a failed drive's context, pending WD's answer to assumption A1." ;
  cs:standing "DESIGN" ; cs:evidenceCeiling "DESIGN_DOCUMENT" ; cs:authorityCeiling "NONE" ;
  cs:supportedBy wde:E02, wde:E17 ; cs:dependsOn wda:A1 ; cs:falsifiedBy wdf:F02 ;
  cs:renderedBy wddeck:slide-03 .

wdc:C03 a cs:Claim ; cs:claimId "C03" ; cs:claimOf wdcs2:case ;
  cs:claimText "A candidate is not an admission and an admission is not authority: a high-scoring candidate cannot become KNOWN, and consequential disposition stays with an engineer." ;
  cs:standing "ALIVE_FIXTURE" ; cs:evidenceCeiling "REPO_LOCAL_FIXTURE" ; cs:authorityCeiling "CONSTRUCT" ;
  cs:supportedBy wde:E03, wde:E04 ; cs:dependsOn wda:A2 ; cs:falsifiedBy wdf:F03, wdf:F04 ;
  cs:renderedBy wddeck:slide-04 .

wdc:C04 a cs:Claim ; cs:claimId "C04" ; cs:claimOf wdcs2:case ;
  cs:claimText "One evidence state is projected into several views; every declared view is derived from the architecture episode." ;
  cs:standing "ALIVE_FIXTURE" ; cs:evidenceCeiling "REPO_LOCAL_FIXTURE" ; cs:authorityCeiling "CONSTRUCT" ;
  cs:supportedBy wde:E05, wde:E15 ; cs:falsifiedBy wdf:F05 ;
  cs:renderedBy wddeck:slide-05 .

wdc:C05 a cs:Claim ; cs:claimId "C05" ; cs:claimOf wdcs2:case ;
  cs:claimText "For a failed drive the agent returns KNOWN only on deterministic evidence closure, PARTIAL when required evidence is missing, and UNKNOWN otherwise." ;
  cs:standing "ALIVE_FIXTURE" ; cs:evidenceCeiling "REPO_LOCAL_FIXTURE" ; cs:authorityCeiling "CONSTRUCT" ;
  cs:supportedBy wde:E03 ; cs:falsifiedBy wdf:F06 ;
  cs:renderedBy wddeck:slide-06 .

wdc:C06 a cs:Claim ; cs:claimId "C06" ; cs:claimOf wdcs2:case ;
  cs:claimText "The data model is object-centric: a learning episode binds work, disposition, receipt and MachineExperience objects with provenance." ;
  cs:standing "ALIVE_FIXTURE" ; cs:evidenceCeiling "REPO_LOCAL_FIXTURE" ; cs:authorityCeiling "CONSTRUCT" ;
  cs:supportedBy wde:E07, wde:E08 ; cs:falsifiedBy wdf:F07 ;
  cs:renderedBy wddeck:slide-07 .

wdc:C07 a cs:Claim ; cs:claimId "C07" ; cs:claimOf wdcs2:case ;
  cs:claimText "Corpus understanding is precomputed; the decision for a case is made on that case's current facts." ;
  cs:standing "DESIGN" ; cs:evidenceCeiling "DESIGN_DOCUMENT" ; cs:authorityCeiling "NONE" ;
  cs:supportedBy wde:E09 ; cs:falsifiedBy wdf:F08 ;
  cs:renderedBy wddeck:slide-08 .

wdc:C08 a cs:Claim ; cs:claimId "C08" ; cs:claimOf wdcs2:case ;
  cs:claimText "Evidence admission fails closed on classification or purpose mismatch and on private evidence without explicit clearance." ;
  cs:standing "ALIVE_FIXTURE" ; cs:evidenceCeiling "REPO_LOCAL_FIXTURE" ; cs:authorityCeiling "CONSTRUCT" ;
  cs:supportedBy wde:E06, wde:E10 ; cs:dependsOn wda:A3 ; cs:falsifiedBy wdf:F09 ;
  cs:renderedBy wddeck:slide-09 .

wdc:C09 a cs:Claim ; cs:claimId "C09" ; cs:claimOf wdcs2:case ;
  cs:claimText "The offline evaluation executes seven negative and positive controls on repository fixtures and reports MTTR as UNMEASURED." ;
  cs:standing "ALIVE_FIXTURE" ; cs:evidenceCeiling "REPO_LOCAL_FIXTURE" ; cs:authorityCeiling "CONSTRUCT" ;
  cs:supportedBy wde:E11, wde:E12 ; cs:falsifiedBy wdf:F10 ;
  cs:renderedBy wddeck:slide-10 .

wdc:C10 a cs:Claim ; cs:claimId "C10" ; cs:claimOf wdcs2:case ;
  cs:claimText "Delivery starts with a bounded 30-day vertical slice in shadow mode, sized to the access WD can authorize." ;
  cs:standing "DESIGN" ; cs:evidenceCeiling "DESIGN_DOCUMENT" ; cs:authorityCeiling "NONE" ;
  cs:supportedBy wde:E13 ; cs:dependsOn wda:A3 ; cs:falsifiedBy wdf:F11 ;
  cs:renderedBy wddeck:slide-11 .

wdc:C11 a cs:Claim ; cs:claimId "C11" ; cs:claimOf wdcs2:case ;
  cs:claimText "An UNKNOWN fixture becomes reusable MachineExperience only after independent verification of the engineer disposition." ;
  cs:standing "ALIVE_FIXTURE" ; cs:evidenceCeiling "REPO_LOCAL_FIXTURE" ; cs:authorityCeiling "CONSTRUCT" ;
  cs:supportedBy wde:E14 ; cs:falsifiedBy wdf:F12 ;
  cs:renderedBy wddeck:slide-12 .

wdc:C12 a cs:Claim ; cs:claimId "C12" ; cs:claimOf wdcs2:case ;
  cs:claimText "The architecture episode's current STOGAF conformance is ST-4 CONSTRAINED." ;
  cs:claimedLevel stogaf:ST4 ;
  cs:standing "ALIVE_FIXTURE" ; cs:evidenceCeiling "REPO_LOCAL_FIXTURE" ; cs:authorityCeiling "SELECT" ;
  cs:supportedBy wde:E15, wde:E16 ; cs:falsifiedBy wdf:F13 .

