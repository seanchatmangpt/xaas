# ---------------------------------------------------------------- assumptions
# Source: 19-SEPTEMBER-25-SUBMISSION.md "Questions already sent to WD and
# interim assumptions". Forwarding confirmation is not an answer.

wda:A1 a cs:Assumption ; cs:assumptionId "A1" ; cs:assumptionOf wdcs2:case ;
  cs:question "When a failed drive comes in, what does the engineer actually do today, and where does the process usually get stuck?" ;
  cs:unknown "Exact current workflow, handoffs, wait states and dominant bottleneck" ;
  cs:interimAssumption "Engineers spend material time reconstructing context and finding applicable prior art before selecting the next diagnostic step" ;
  cs:changeIfDifferent "I would remap the first vertical slice around the measured bottleneck rather than preserve my assumed workflow" ;
  cs:askedOn "2026-09-23"^^xsd:date ; cs:askedVia "Pradyot Kar" ; cs:answerStatus "UNANSWERED" .

wda:A2 a cs:Assumption ; cs:assumptionId "A2" ; cs:assumptionOf wdcs2:case ;
  cs:question "When evidence disagrees — prior FA history, build data, current test results and engineer judgment — what is authoritative?" ;
  cs:unknown "WD's precedence, escalation and ground-truth policy" ;
  cs:interimAssumption "No source is allowed to silently dominate; contradictions remain visible and consequential disposition stays with an engineer" ;
  cs:changeIfDifferent "Admission rules, evidence precedence and escalation policy would be revised to WD's actual governance model" ;
  cs:askedOn "2026-09-23"^^xsd:date ; cs:askedVia "Pradyot Kar" ; cs:answerStatus "UNANSWERED" .

wda:A3 a cs:Assumption ; cs:assumptionId "A3" ; cs:assumptionOf wdcs2:case ;
  cs:question "If I had 30 days to prove usefulness, what data and systems would I realistically have access to, and what result would the team want to see first?" ;
  cs:unknown "Accessible sources, security constraints, representative corpus and first success metric" ;
  cs:interimAssumption "Start with a bounded historical/redacted corpus plus whatever structured build facts WD can authorize; use shadow-only recommendations" ;
  cs:changeIfDifferent "The first 30-day slice and measurement plan would be narrowed or expanded around the actual access envelope" ;
  cs:askedOn "2026-09-23"^^xsd:date ; cs:askedVia "Pradyot Kar" ; cs:answerStatus "UNANSWERED" .
