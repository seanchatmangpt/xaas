@prefix stogaf: <urn:xaas:stogaf:> .
@prefix wdcs2: <urn:xaas:wd-cs2:> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix pplan: <http://purl.org/net/p-plan#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

stogaf:profile a prov:Entity ;
  dct:title "Semantic TOGAF v26.9.22" ;
  dct:description "TOGAF-compatible semantic execution profile; not an official Open Group specification." .

stogaf:ArchitectureState a skos:Concept ; skos:prefLabel "Architecture State" .
stogaf:Requirement a skos:Concept ; skos:prefLabel "Requirement" .
stogaf:Constraint a skos:Concept ; skos:prefLabel "Constraint" .
stogaf:Capability a skos:Concept ; skos:prefLabel "Capability" .
stogaf:Viewpoint a skos:Concept ; skos:prefLabel "Viewpoint" .
stogaf:View a skos:Concept ; skos:prefLabel "View" .
stogaf:Gap a skos:Concept ; skos:prefLabel "Gap" .
stogaf:Transition a skos:Concept ; skos:prefLabel "Transition" .
stogaf:Evidence a skos:Concept ; skos:prefLabel "Evidence" .
stogaf:Authority a skos:Concept ; skos:prefLabel "Authority" .
stogaf:Verification a skos:Concept ; skos:prefLabel "Verification" .
stogaf:MachineExperience a skos:Concept ; skos:prefLabel "MachineExperience" .

wdcs2:architectureEpisode a prov:Activity, pplan:Plan ;
  dct:title "WD Case Study 2 STOGAF architecture episode" ;
  dct:description "Failure-analysis quality loop projected through STOGAF." .

wdcs2:baselineArchitecture a prov:Entity ;
  dct:title "Fragmented FA baseline" ;
  dct:description "Failure-analysis evidence and work require repeated human reconstruction across reports and structured provenance." .

wdcs2:targetArchitecture a prov:Entity ;
  dct:title "Semantic closed-loop FA target" ;
  dct:description "Verified FA work becomes reusable prior art while consequential disposition remains with an engineer." .

wdcs2:architectureGap a prov:Entity ;
  dct:title "Architecture closure gap" ;
  dct:description "Canonical graph to work, capability, view, verification and replay projections must close without human reconstruction." .

wdcs2:implementationGovernance a prov:Activity ;
  dct:identifier "ADM-G" ;
  dct:title "Implementation Governance" ;
  dct:description "Chicago, Playwright, exact-head CI and receipt courts." .

wdcs2:architectureChangeManagement a prov:Activity ;
  dct:identifier "ADM-H" ;
  dct:title "Architecture Change Management" ;
  dct:description "Verified MachineExperience changes future standard work." .

wdcs2:faEngineerViewpoint a prov:Entity ;
  dct:title "FA Engineer Viewpoint" ;
  dct:description "What requires engineer judgment now?" .

wdcs2:morningBriefView a prov:Entity ;
  dct:title "FA Morning Brief" ;
  dct:description "Projection of O* for the FA engineer viewpoint." ;
  prov:wasDerivedFrom wdcs2:architectureEpisode .

wdcs2:sjiraProjection a prov:Entity ;
  dct:title "Semantic Jira work projection" ;
  dct:description "Work obligations projected from admitted architecture state." ;
  prov:wasDerivedFrom wdcs2:architectureEpisode .

wdcs2:sa2aProjection a prov:Entity ;
  dct:title "Semantic A2A capability projection" ;
  dct:description "Typed bounded capability interaction; no ambient DO authority." ;
  prov:wasDerivedFrom wdcs2:architectureEpisode .

wdcs2:currentConformance a skos:Concept ;
  skos:prefLabel "ST-4 CONSTRAINED" .

wdcs2:targetConformance a skos:Concept ;
  skos:prefLabel "ST-6 AUTONOMIC" .

wdcs2:humanAuthority a org:Role ;
  skos:prefLabel "ENGINEER_DISPOSITION_REQUIRED" .

wdcs2:machineExperienceContract a prov:Plan ;
  dct:title "MachineExperience admission contract" ;
  dct:description "Requires verified consequence, provenance, applicability, evidence ceiling and replay identity." .
