PREFIX stogaf: <urn:xaas:stogaf:>

# Each UNION branch binds its own subject. Under strict SPARQL bottom-up
# evaluation a nested group cannot see variables bound outside it; rdflib
# happens to substitute them for FILTER NOT EXISTS, but not for a plain FILTER
# (gate 020's pre-v26.9.25 conformance branch returned 0 rows on ST-7 input).
# Branch-local binding keeps every gate engine-portable.
SELECT ?experience ?reason WHERE {
  {
    ?experience a stogaf:MachineExperience .
    FILTER NOT EXISTS { ?experience stogaf:requiresEvidence ?value }
    BIND("machine-experience-missing-evidence" AS ?reason)
  } UNION {
    ?experience a stogaf:MachineExperience .
    FILTER NOT EXISTS { ?experience stogaf:applicability ?value }
    BIND("machine-experience-missing-applicability" AS ?reason)
  } UNION {
    ?experience a stogaf:MachineExperience .
    FILTER NOT EXISTS { ?experience stogaf:replayIdentity ?value }
    BIND("machine-experience-missing-replay-identity" AS ?reason)
  } UNION {
    ?experience a stogaf:MachineExperience .
    FILTER NOT EXISTS { ?experience stogaf:receiptIdentity ?value }
    BIND("machine-experience-missing-receipt" AS ?reason)
  }
}
ORDER BY ?experience ?reason
