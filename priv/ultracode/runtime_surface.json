{
  "schema": "xaas-ultracode-runtime-surface/v1",
  "law": "ExternalSemanticPorts(UltraCode) = {SA2A, sJira}; local construction is a separate classified set; consequential DO only via BRCE (Xaas.Actuation.run/4)",
  "semantic_ports": [
    "sa2a",
    "sjira"
  ],
  "local_primitives": [
    "filesystem",
    "local_shell",
    "compiler",
    "test_runner",
    "generator",
    "local_git"
  ],
  "direct_external": "deny",
  "consequences": [
    "local_reversible",
    "local_durable",
    "external_read",
    "external_write",
    "external_consequential"
  ],
  "mediations": [
    "local",
    "sjira",
    "sa2a",
    "brce"
  ],
  "tools": [
    {
      "name": "Read",
      "category": "filesystem",
      "consequence": "local_reversible",
      "agent_visible": true,
      "mediated_by": "local",
      "authority_required": false,
      "lease_admit": true,
      "refusal": null
    },
    {
      "name": "Grep",
      "category": "filesystem",
      "consequence": "local_reversible",
      "agent_visible": true,
      "mediated_by": "local",
      "authority_required": false,
      "lease_admit": true,
      "refusal": null
    },
    {
      "name": "Glob",
      "category": "filesystem",
      "consequence": "local_reversible",
      "agent_visible": true,
      "mediated_by": "local",
      "authority_required": false,
      "lease_admit": true,
      "refusal": null
    },
    {
      "name": "Edit",
      "category": "filesystem",
      "consequence": "local_durable",
      "agent_visible": true,
      "mediated_by": "local",
      "authority_required": false,
      "lease_admit": true,
      "refusal": null
    },
    {
      "name": "Write",
      "category": "filesystem",
      "consequence": "local_durable",
      "agent_visible": true,
      "mediated_by": "local",
      "authority_required": false,
      "lease_admit": true,
      "refusal": null
    },
    {
      "name": "Task",
      "category": "local_shell",
      "consequence": "local_reversible",
      "agent_visible": true,
      "mediated_by": "local",
      "authority_required": false,
      "lease_admit": true,
      "refusal": null
    },
    {
      "name": "TodoWrite",
      "category": "filesystem",
      "consequence": "local_reversible",
      "agent_visible": true,
      "mediated_by": "local",
      "authority_required": false,
      "lease_admit": true,
      "refusal": null
    },
    {
      "name": "Bash",
      "category": "local_shell",
      "consequence": "local_durable",
      "agent_visible": true,
      "mediated_by": "local",
      "authority_required": false,
      "lease_admit": false,
      "refusal": "refused_no_authority",
      "note": "argv-allowlisted by the xaas-gate hook (gate.git_subs/read_helpers); never lease-admitted as a general tool"
    },
    {
      "name": "WebFetch",
      "category": "external_http",
      "consequence": "external_read",
      "agent_visible": false,
      "mediated_by": "sa2a",
      "authority_required": false,
      "lease_admit": false,
      "refusal": "forbidden_external_semantic_edge",
      "required": "UltraCode -> SA2A -> resolve_capability"
    },
    {
      "name": "WebSearch",
      "category": "external_http",
      "consequence": "external_read",
      "agent_visible": false,
      "mediated_by": "sa2a",
      "authority_required": false,
      "lease_admit": false,
      "refusal": "forbidden_external_semantic_edge",
      "required": "UltraCode -> SA2A -> resolve_capability"
    },
    {
      "name": "git_push",
      "category": "remote_git",
      "consequence": "external_consequential",
      "agent_visible": false,
      "mediated_by": "brce",
      "authority_required": true,
      "lease_admit": false,
      "refusal": "refused_no_authority",
      "required": "UltraCode -> SA2A -> publish_change -> actuate (BRCE)"
    },
    {
      "name": "publish",
      "category": "remote_publication",
      "consequence": "external_consequential",
      "agent_visible": false,
      "mediated_by": "brce",
      "authority_required": true,
      "lease_admit": false,
      "refusal": "refused_no_authority",
      "required": "UltraCode -> SA2A -> publish_change -> actuate (BRCE)"
    },
    {
      "name": "mcp__xaas-execution__claim_next",
      "category": "semantic_port",
      "consequence": "local_durable",
      "agent_visible": true,
      "mediated_by": "sjira",
      "authority_required": false,
      "lease_admit": false,
      "refusal": null
    },
    {
      "name": "mcp__xaas-execution__heartbeat",
      "category": "semantic_port",
      "consequence": "local_durable",
      "agent_visible": true,
      "mediated_by": "sjira",
      "authority_required": false,
      "lease_admit": false,
      "refusal": null
    },
    {
      "name": "mcp__xaas-execution__admit_tool",
      "category": "semantic_port",
      "consequence": "local_reversible",
      "agent_visible": true,
      "mediated_by": "sjira",
      "authority_required": false,
      "lease_admit": false,
      "refusal": null
    },
    {
      "name": "mcp__xaas-execution__record_provider_event",
      "category": "semantic_port",
      "consequence": "local_durable",
      "agent_visible": true,
      "mediated_by": "sjira",
      "authority_required": false,
      "lease_admit": false,
      "refusal": null
    },
    {
      "name": "mcp__xaas-execution__close_candidate",
      "category": "semantic_port",
      "consequence": "local_durable",
      "agent_visible": true,
      "mediated_by": "sjira",
      "authority_required": false,
      "lease_admit": false,
      "refusal": null
    },
    {
      "name": "mcp__xaas-execution__refuse",
      "category": "semantic_port",
      "consequence": "local_durable",
      "agent_visible": true,
      "mediated_by": "sjira",
      "authority_required": false,
      "lease_admit": false,
      "refusal": null
    },
    {
      "name": "mcp__xaas-execution__cancel_work",
      "category": "semantic_port",
      "consequence": "local_durable",
      "agent_visible": true,
      "mediated_by": "sjira",
      "authority_required": false,
      "lease_admit": false,
      "refusal": null
    },
    {
      "name": "mcp__xaas-execution__surface",
      "category": "semantic_port",
      "consequence": "local_reversible",
      "agent_visible": true,
      "mediated_by": "sjira",
      "authority_required": false,
      "lease_admit": false,
      "refusal": null
    },
    {
      "name": "mcp__xaas-execution__resolve_capability",
      "category": "semantic_port",
      "consequence": "local_reversible",
      "agent_visible": true,
      "mediated_by": "sa2a",
      "authority_required": false,
      "lease_admit": false,
      "refusal": null
    },
    {
      "name": "mcp__xaas-execution__actuate",
      "category": "semantic_port",
      "consequence": "external_consequential",
      "agent_visible": true,
      "mediated_by": "brce",
      "authority_required": true,
      "lease_admit": false,
      "refusal": null
    },
    {
      "name": "MultiEdit",
      "category": "filesystem",
      "consequence": "local_durable",
      "agent_visible": true,
      "mediated_by": "local",
      "authority_required": false,
      "lease_admit": false,
      "refusal": null,
      "note": "gate TOOL_MAP admits it as Edit"
    },
    {
      "name": "NotebookEdit",
      "category": "filesystem",
      "consequence": "local_durable",
      "agent_visible": true,
      "mediated_by": "local",
      "authority_required": false,
      "lease_admit": false,
      "refusal": null,
      "note": "gate TOOL_MAP admits it as Edit"
    },
    {
      "name": "TaskOutput",
      "category": "local_shell",
      "consequence": "local_reversible",
      "agent_visible": true,
      "mediated_by": "local",
      "authority_required": false,
      "lease_admit": false,
      "refusal": null,
      "note": "gate TOOL_MAP admits it as Task"
    },
    {
      "name": "TaskStop",
      "category": "local_shell",
      "consequence": "local_reversible",
      "agent_visible": true,
      "mediated_by": "local",
      "authority_required": false,
      "lease_admit": false,
      "refusal": null,
      "note": "gate TOOL_MAP admits it as Task"
    },
    {
      "name": "Skill",
      "category": "local_shell",
      "consequence": "local_reversible",
      "agent_visible": true,
      "mediated_by": "local",
      "authority_required": false,
      "lease_admit": false,
      "refusal": null,
      "note": "gate local_only; what a Skill executes is zcode-cli internal (residual)"
    },
    {
      "name": "Agent",
      "category": "local_shell",
      "consequence": "local_durable",
      "agent_visible": false,
      "mediated_by": "local",
      "authority_required": false,
      "lease_admit": false,
      "refusal": "refused_no_authority",
      "note": "subagent tool calls bypass PreToolUse; gate denies unless XAAS_ALLOW_SUBAGENTS=1, which WorkerEnv never forwards"
    }
  ],
  "gate": {
    "pre_lease_ok": [
      "Read",
      "Grep",
      "Glob",
      "TodoWrite",
      "Skill"
    ],
    "local_only": [
      "Skill"
    ],
    "git_subs": [
      "add",
      "commit",
      "status",
      "diff",
      "log",
      "rev-parse",
      "show",
      "ls-files"
    ],
    "git_sweep_subs": [
      "status",
      "diff",
      "log",
      "rev-parse",
      "show",
      "ls-files"
    ],
    "git_forbidden": [
      "-c",
      "--exec-path",
      "--namespace",
      "--no-index",
      "-F",
      "--file",
      "-t",
      "--template"
    ],
    "read_helpers": [
      "ls",
      "cat",
      "head",
      "tail",
      "wc"
    ],
    "sensitive_home_dirs": [
      ".aws",
      ".cargo",
      ".claude",
      ".config",
      ".docker",
      ".git-credentials",
      ".gitconfig",
      ".gnupg",
      ".hex",
      ".kube",
      ".netrc",
      ".npmrc",
      ".pgpass",
      ".ssh",
      ".zcode"
    ],
    "deny_tools": [
      "WebFetch",
      "WebSearch"
    ],
    "port_tools": [
      "claim_next",
      "heartbeat",
      "admit_tool",
      "record_provider_event",
      "close_candidate",
      "refuse",
      "cancel_work",
      "surface",
      "resolve_capability",
      "actuate"
    ]
  },
  "worker_env": {
    "allow_names": [
      "ASDF_DATA_DIR",
      "ASDF_DIR",
      "HOME",
      "LANG",
      "LC_ALL",
      "LC_COLLATE",
      "LC_CTYPE",
      "LC_MESSAGES",
      "LC_MONETARY",
      "LC_NUMERIC",
      "LC_TIME",
      "LOGNAME",
      "MIX_BUILD_ROOT",
      "MIX_ENV",
      "MIX_HOME",
      "PATH",
      "SHELL",
      "TERM",
      "TMPDIR",
      "TZ",
      "USER",
      "XAAS_LEASE_CWD",
      "XAAS_LEASE_ID",
      "XAAS_MCP_URL",
      "XAAS_WORKER",
      "ZCODE_FABRIC_MAX_CONCURRENT",
      "ZCODE_NODE",
      "ZCODE_OCEL",
      "ZCODE_SUBAGENT_MAX_TURNS",
      "ZCODE_TUI_RUNTIME_LOG"
    ],
    "allow_prefixes": [],
    "model_provider_names": [
      "ANTHROPIC_API_KEY",
      "ANTHROPIC_AUTH_TOKEN",
      "ANTHROPIC_BASE_URL",
      "ZCODE_API_KEY"
    ],
    "port_credential_names": [
      "XAAS_MCP_TOKEN"
    ],
    "deny_names": [
      "BASH_ENV",
      "BOTO_CONFIG",
      "CARGO_HOME",
      "CURL_HOME",
      "DATABASE_URL",
      "DOCKER_HOST",
      "DSN",
      "ELIXIR_ERL_OPTIONS",
      "ENV",
      "ERL_AFLAGS",
      "ERL_FLAGS",
      "ERL_LIBS",
      "ERL_ZFLAGS",
      "GH_ENTERPRISE_TOKEN",
      "GH_TOKEN",
      "GITHUB_PAT",
      "GITHUB_TOKEN",
      "GIT_ASKPASS",
      "GNUPGHOME",
      "HEX_API_KEY",
      "HEX_HOME",
      "HEX_MIRROR",
