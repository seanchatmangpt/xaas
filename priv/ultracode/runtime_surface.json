    "name_regex": "^[A-Z_][A-Z0-9_]*$",
    "deny_word_regex": "(TOKEN|SECRET|PASSWORD|PASSWD|CREDENTIAL|APIKEY|AUTH|BEARER|COOKIE|PRIVATE|PRIVKEY|KEY|JWT|HMAC|MNEMONIC|SIGNING|WEBHOOK|SIGNER)|(^|_)(PASS|PWD|PAT|SESSION|CERTS?|DSN|URI|CONNECTION_STRING|OTP|TOTP|SEED|SALT|SID|HOOK|CA_BUNDLE|ENDPOINT)(_|$|[0-9])",
    "url_names_no_userinfo": [
      "ANTHROPIC_BASE_URL",
      "XAAS_MCP_URL"
    ],
    "credential_value_regex": "(?i)^[a-z][a-z0-9+.-]*:[^\\s]*@|password=|pwd=|;\\s*pass=",
    "secret_value_regex": "(sk-ant-|sk-[A-Za-z0-9_-]{16,}|eyJ[A-Za-z0-9_-]{8,}|gh[pousr]_[A-Za-z0-9]{8,}|github_pat_|xox[abpr]-|AKIA[0-9A-Z]{12,}|hooks\\.slack\\.com|/api/webhooks/|-----BEGIN|;|%40)"
  }
}
