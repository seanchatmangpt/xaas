---
to: "marketplace/xaas-fabric/hooks/hooks.json"
force: true
sparql:
  hooks: |
    PREFIX zp: <http://seanchatmangpt.github.io/packs/zcode-plugin#>
    SELECT ?script ?timeout ?status WHERE {
      ?h a zp:Hook ; zp:hookEvent "PreToolUse" ; zp:hookScript ?script ;
         zp:hookTimeout ?timeout ; zp:hookStatusMessage ?status .
    }
---
{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {% for h in hooks %}{
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/{{ h.script }}\"",
            "timeout": {{ h.timeout }},
            "statusMessage": {{ h.status | json_encode }}
          }{% if not loop.last %},
          {% endif %}{% endfor %}
        ]
      }
    ]
  }
}
