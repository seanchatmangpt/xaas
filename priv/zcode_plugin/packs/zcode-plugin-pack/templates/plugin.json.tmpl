---
to: "marketplace/xaas-fabric/.zcode-plugin/plugin.json"
force: true
sparql:
  plugin: |
    PREFIX zp: <http://seanchatmangpt.github.io/packs/zcode-plugin#>
    SELECT ?name ?version ?description ?endpoint ?mcpServer ?mcpPath ?tokenKey ?source WHERE {
      ?p a zp:Plugin ; zp:pluginName ?name ; zp:version ?version ; zp:description ?description ;
         zp:endpoint ?endpoint ; zp:mcpServerName ?mcpServer ; zp:mcpPath ?mcpPath ;
         zp:tokenUserConfigKey ?tokenKey ; zp:sourcePath ?source .
    }
---
{
  "name": {{ plugin[0].name | json_encode }},
  "version": {{ plugin[0].version | json_encode }},
  "description": {{ plugin[0].description | json_encode }},
  "userConfig": {
    {{ plugin[0].tokenKey | json_encode }}: {
      "type": "string",
      "sensitive": false,
      "default": "unset",
      "description": "Bearer token for the XaaS internal API (/internal-api). Set with: zcode plugins configure {{ plugin[0].name }}@<marketplace> --options-file"
    }
  }
}
