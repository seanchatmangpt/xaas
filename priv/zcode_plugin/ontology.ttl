@prefix zp: <http://seanchatmangpt.github.io/packs/zcode-plugin#> .

# ZCode plugin topology for the XaaS execution fabric. Source of truth for
# every manifest and every command/agent/skill frontmatter under
# marketplace/. Project root: `cd priv/zcode_plugin && ggen sync run`.
# Prose bodies and the two node scripts are the irreducible handwritten
# residue (see HANDWRITTEN.md); everything else here is projected.

<urn:zp:marketplace/xaas-fabric-marketplace> a zp:Marketplace ;
    zp:marketplaceName "xaas-fabric-marketplace" ;
    zp:ownerName "xaas" ;
    zp:includesPlugin <urn:zp:plugin/xaas-fabric> .

<urn:zp:plugin/xaas-fabric> a zp:Plugin ;
    zp:pluginName "xaas-fabric" ;
    zp:version "26.9.17" ;
    zp:description "XaaS execution-fabric worker plugin: claims receipted work contracts via MCP (claim_next/admit_tool/close_candidate/refuse), closes with head verification, and enforces admission on the host with a PreToolUse gate in dispatcher-launched (XAAS_WORKER=1) sessions." ;
    zp:endpoint "http://localhost:4000" ;
    zp:mcpServerName "xaas-execution" ;
    zp:mcpPath "/internal-api/execution/mcp" ;
    zp:tokenUserConfigKey "zcode_xaas_token" ;
    zp:sourcePath "./xaas-fabric" .

<urn:zp:hook/xaas-gate> a zp:Hook ;
    zp:hookOf <urn:zp:plugin/xaas-fabric> ;
    zp:hookEvent "PreToolUse" ;
    zp:hookScript "xaas-gate.mjs" ;
    zp:hookTimeout 30 ;
    zp:hookStatusMessage "xaas-gate: admitting tool call" .

<urn:zp:command/xaas> a zp:Command ;
    zp:commandOf <urn:zp:plugin/xaas-fabric> ;
    zp:name "xaas" ;
    zp:description "Claim and execute one admitted XaaS work contract in this worktree" ;
    zp:argumentHint "[work-id]" .

<urn:zp:agent/xaas-worker> a zp:Agent ;
    zp:agentOf <urn:zp:plugin/xaas-fabric> ;
    zp:name "xaas-worker" ;
    zp:description "A leased XaaS execution worker for fan-out construction inside a claimed worktree. Claimed work only; no merge/publish authority." ;
    zp:tools "Read, Grep, Glob, Edit, Write, Bash" .

<urn:zp:skill/xaas-worker> a zp:Skill ;
    zp:skillOf <urn:zp:plugin/xaas-fabric> ;
    zp:name "xaas-worker" ;
    zp:description "Operating doctrine for a leased XaaS execution worker (claim, admit, verify, close). Use when executing work claimed from the xaas-execution MCP server." .
