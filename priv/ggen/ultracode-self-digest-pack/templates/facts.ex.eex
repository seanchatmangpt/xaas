# GENERATED by ultracode-self-digest-pack (ggen_igniter renderer). Do not hand-edit.
# Regenerate: mix ggen_igniter.sync --pack-dir priv/ggen/ultracode-self-digest-pack \
#   --template templates/facts.ex.eex --yes
defmodule Xaas.Ultracode.CapitalCensus.Facts do
  @moduledoc """
  Digest-law FACTS as data, projected from `priv/ggen/ultracode-self-digest-pack/ontology.ttl`.
  The G-table, the classified residual shapes and the recurrence threshold are
  ontology individuals — classification consumes them as a HYPOTHESIS source;
  it is never a conclusion until the falsifier replays.
  """

  @g_table [
<%= for g <- g_table do %>    %{class: :<%= g["className"] %>, primitive: :<%= g["primitiveName"] %>},
<% end %>  ]

  @frontier_outcomes [
<%= for o <- frontier_outcomes do %>    :<%= o["name"] %>,
<% end %>  ]

  @shape_classes [
<%= for s <- facts do %>    %{shape: "<%= s["shape"] %>", class: :<%= s["className"] %>, primitive: :<%= s["primitiveName"] %>},
<% end %>  ]

  @recurrence_threshold <%= recurrence_threshold %>

  def g_table, do: @g_table
  def frontier_outcomes, do: @frontier_outcomes
  def shape_classes, do: @shape_classes
  def recurrence_threshold, do: @recurrence_threshold

  def primitive_for(class) do
    case Enum.find(@g_table, &(&1.class == class)) do
      %{primitive: primitive} -> primitive
      nil -> nil
    end
  end
end
