// PreToolUse: the per-consequence admission court.
//
// ALLOW only on an explicit server allow for a held lease. Everything else
// denies: unknown lease, expired lease, tool above authority ceiling,
// server refusal, transport failure, malformed payload. An unreachable
// control plane can never widen into an allowed tool call.
import { readStdin, post, loadLease, deny, allow, toolName, toolInput, leaseToken } from "./xaas_common.mjs";

const evt = await readStdin();
const lease = await loadLease(evt.cwd);

try {
  const res = await post("pre_tool_use", {
    lease_token: leaseToken(evt, lease),
    tool: toolName(evt),
    input: toolInput(evt),
    cwd: evt.cwd,
    session_id: evt.session_id,
    tool_use_id: evt.tool_use_id,
  });

  if (res.ok && res.body?.decision === "allow") {
    allow();
  }

  deny(res.body?.reason ?? "BRCE_REFUSED", `status=${res.status}`);
} catch (err) {
  deny("BRCE_UNAVAILABLE", err?.message ?? err);
}
