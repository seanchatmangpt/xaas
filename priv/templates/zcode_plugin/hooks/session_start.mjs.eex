// SessionStart: worker advertisement. Registers this provider session as
// an available execution worker. Best-effort — without a lease there is
// nothing to protect yet, and claim_next re-registers idempotently.
import { readStdin, post, done } from "./xaas_common.mjs";

const evt = await readStdin();

try {
  const res = await post("session_start", {
    provider: "zcode",
    provider_worker_id: evt.session_id,
    session_id: evt.session_id,
    repository: evt.repository ?? null,
    worktree: evt.cwd,
    capabilities: evt.capabilities ?? {},
  });
  done({ status: res.ok ? "advertised" : "advertisement_refused" });
} catch {
  done({ status: "advertisement_skipped" });
}
