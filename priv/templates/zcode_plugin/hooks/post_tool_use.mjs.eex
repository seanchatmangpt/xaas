// PostToolUse / PostToolUseFailure: observation recording.
//
// A recorded event proves the provider executed the tool — never that the
// semantic subject closed. Observations are best-effort: a recording
// failure does not block the provider.
import { readStdin, post, loadLease, done, toolName, leaseToken } from "./xaas_common.mjs";

const evt = await readStdin();
const lease = await loadLease(evt.cwd);

try {
  await post("post_tool_use", {
    lease_token: leaseToken(evt, lease),
    event: {
      hook: "post_tool_use",
      tool: toolName(evt),
      tool_use_id: evt.tool_use_id,
      cwd: evt.cwd,
      session_id: evt.session_id,
    },
  });
  done({ status: "recorded" });
} catch {
  done({ status: "record_skipped" });
}
