# eds.ttl — Executable Design Science core ontology
# Governing document: EDS Program Charter v0.1 (2026-09-12). Section refs below
# point at the charter section that requires each class/property to exist.
#
# Reuse discipline (same as bb: in ~/sos and public-vocab-only in dteam/ccog):
# only invent a term when no public vocabulary already covers it. prov:/dcterms:/
# skos: are reused wherever their semantics genuinely match; eds: is minted only
# for the closed evidence-state lattice (charter §8) and the ERC tuple (§14),
# neither of which has a public-vocab equivalent.

@prefix eds:     <https://executable-design-science.org/ontology#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .

# ===========================================================================
# 1. The Executable Research Claim tuple — charter §14
#    ERC = <H, A, F, E, V>
# ===========================================================================

eds:ExecutableResearchClaim a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Executable Research Claim"@en ;
    rdfs:comment """The primitive scientific unit in EDS (charter §14), not the
paper. An immutable record binding a hypothesis to the machinery capable of
testing it: <H, A, F, E, V>. prov:Entity because an ERC is itself a
generated, referenceable research artifact (prov:wasGeneratedBy the act of
declaring it), not a process.""" .

eds:hypothesis a rdf:Property , owl:DatatypeProperty ;
    rdfs:domain eds:ExecutableResearchClaim ;
    rdfs:range xsd:string ;
    rdfs:label "hypothesis (H)"@en ;
    rdfs:comment "The stated, falsifiable research proposition (charter §4, §7)." .

eds:hasArtifact a rdf:Property , owl:ObjectProperty ;
    rdfs:domain eds:ExecutableResearchClaim ;
    rdfs:range eds:Artifact ;
    rdfs:label "artifact (A)"@en ;
    rdfs:comment "The executable artifact operationalizing the hypothesis (charter §2)." .

eds:hasFalsifier a rdf:Property , owl:ObjectProperty ;
    rdfs:domain eds:ExecutableResearchClaim ;
    rdfs:range eds:Falsifier ;
    rdfs:label "falsifier (F)"@en ;
    rdfs:comment """Required, not optional. Charter §7: NoFalsifier =>
NoStrongEDSClaim. An ERC record with no eds:hasFalsifier triple is a WEAK
claim by construction and must be reported as such, never silently upgraded.""" .

eds:hasEvidence a rdf:Property , owl:ObjectProperty ;
    rdfs:domain eds:ExecutableResearchClaim ;
    rdfs:range eds:Evidence ;
    rdfs:label "evidence (E)"@en ;
    rdfs:comment "Execution evidence gathered for this claim (charter §2, §9)." .

eds:hasVerification a rdf:Property , owl:ObjectProperty ;
    rdfs:domain eds:ExecutableResearchClaim ;
    rdfs:range eds:VerificationProcedure ;
    rdfs:label "verification (V)"@en ;
    rdfs:comment "The procedure that judged whether evidence supports the claim (charter §14, §18: Verifier role distinct from Author)." .

# ===========================================================================
# 2. Full EDSResult tuple — charter §2
#    EDSResult = <Claim, Theory, Artifact, Experiment, Environment, Execution,
#                 Evidence, Falsifier, Analysis, Reproduction>
# ===========================================================================

eds:EDSResult a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "EDS Result"@en ;
    rdfs:comment """A complete result per charter §2. No component silently
substitutes for another — a paper is not the system, a repo is not an
execution, a passing test is not proof of the hypothesis, a benchmark number
is not meaningful without its conditions, a receipt is not independent
evidence without provenance/standing.""" .

eds:Theory       a owl:Class ; rdfs:subClassOf prov:Entity ; rdfs:label "Theory"@en .
eds:Artifact     a owl:Class ; rdfs:subClassOf prov:Entity ; rdfs:label "Artifact"@en ;
    rdfs:comment "An executable artifact whose behavior operationalizes a hypothesis (charter §2)." .
eds:Experiment   a owl:Class ; rdfs:subClassOf prov:Activity ; rdfs:label "Experiment"@en .
eds:Environment  a owl:Class ; rdfs:subClassOf prov:Entity ; rdfs:label "Environment"@en ;
    rdfs:comment "Declared execution environment (charter §8: EXECUTABLE requires this to be stated)." .
eds:Execution    a owl:Class ; rdfs:subClassOf prov:Activity ; rdfs:label "Execution"@en .
eds:Evidence     a owl:Class ; rdfs:subClassOf prov:Entity ; rdfs:label "Evidence"@en ;
    rdfs:comment "Independently inspectable evidence generated by an Execution (charter §2)." .
eds:Falsifier    a owl:Class ; rdfs:subClassOf prov:Entity ; rdfs:label "Falsifier"@en ;
    rdfs:comment "F(H): an observation which, if made, reduces or destroys standing of H (charter §7)." .
eds:Analysis     a owl:Class ; rdfs:subClassOf prov:Activity ; rdfs:label "Analysis"@en .
eds:Reproduction a owl:Class ; rdfs:subClassOf prov:Activity ; rdfs:label "Reproduction"@en ;
    rdfs:comment "An independent execution attempt (charter §18: Reproducer role distinct from Author/Executor)." .
eds:VerificationProcedure a owl:Class ; rdfs:subClassOf prov:Entity ; rdfs:label "Verification Procedure"@en .

eds:forClaim a rdf:Property , owl:ObjectProperty ;
    rdfs:domain eds:EDSResult ; rdfs:range eds:ExecutableResearchClaim ;
    rdfs:label "for claim"@en .

# ===========================================================================
# 3. Evidence state lattice — charter §8 (closed vocabulary, must not collapse)
# ===========================================================================

eds:EvidenceStateScheme a skos:ConceptScheme ;
    skos:prefLabel "EDS Evidence State"@en ;
    dcterms:description """Closed status floor per charter §8, extended per the
paper to 11 states (src/eds/states.py:EvidenceState). States must not
collapse: IMPLEMENTED != VERIFIED, EXECUTABLE != REPRODUCED,
TEST_PASS != SCIENTIFIC_PROOF. Ordering below is NOT a strict total order —
FALSIFIED, BLOCKED, UNSUPPORTED, and UNKNOWN are terminal/side states
reachable from any prior state, not a step past REPRODUCED.""" .

eds:PROPOSED     a skos:Concept ; skos:inScheme eds:EvidenceStateScheme ; skos:prefLabel "PROPOSED"@en ;
    skos:definition "Theoretically stated but not implemented." .
eds:IMPLEMENTED  a skos:Concept ; skos:inScheme eds:EvidenceStateScheme ; skos:prefLabel "IMPLEMENTED"@en ;
    skos:definition "Artifact exists." .
eds:EXECUTABLE   a skos:Concept ; skos:inScheme eds:EvidenceStateScheme ; skos:prefLabel "EXECUTABLE"@en ;
    skos:definition "Artifact has successfully executed in a declared environment." .
eds:OBSERVED     a skos:Concept ; skos:inScheme eds:EvidenceStateScheme ; skos:prefLabel "OBSERVED"@en ;
    skos:definition "Execution generated inspectable evidence." .
eds:VERIFIED     a skos:Concept ; skos:inScheme eds:EvidenceStateScheme ; skos:prefLabel "VERIFIED"@en ;
    skos:definition "Evidence supports the specific claim under stated conditions." .
eds:REPRODUCIBLE a skos:Concept ; skos:inScheme eds:EvidenceStateScheme ; skos:prefLabel "REPRODUCIBLE"@en ;
    skos:definition "Another execution under sufficiently equivalent conditions obtains the expected result." .
eds:REPRODUCED   a skos:Concept ; skos:inScheme eds:EvidenceStateScheme ; skos:prefLabel "REPRODUCED"@en ;
    skos:definition "An independent researcher or team has actually obtained the result." .
eds:FALSIFIED    a skos:Concept ; skos:inScheme eds:EvidenceStateScheme ; skos:prefLabel "FALSIFIED"@en ;
    skos:definition "Evidence contradicts the declared hypothesis under admitted conditions." .
eds:BLOCKED      a skos:Concept ; skos:inScheme eds:EvidenceStateScheme ; skos:prefLabel "BLOCKED"@en ;
    skos:definition "Progress cannot continue due to an external dependency, permission, or missing capability, not a falsification of the hypothesis itself." .
eds:UNSUPPORTED  a skos:Concept ; skos:inScheme eds:EvidenceStateScheme ; skos:prefLabel "UNSUPPORTED"@en ;
    skos:definition "The claimed mechanism is not supported by the current tooling/generator/environment, distinct from FALSIFIED (which requires contradicting evidence, not merely absent capability)." .
eds:UNKNOWN      a skos:Concept ; skos:inScheme eds:EvidenceStateScheme ; skos:prefLabel "UNKNOWN"@en ;
    skos:definition "Available evidence is insufficient to classify the claim." .

eds:evidenceState a rdf:Property , owl:ObjectProperty ;
    rdfs:domain eds:ExecutableResearchClaim ;
    rdfs:range skos:Concept ;
    rdfs:label "evidence state"@en .

# ===========================================================================
# 4. Receipt — charter §9
#    R_E = receipt(claim, artifact, source, environment, inputs, execution,
#                   outputs, validators)
# ===========================================================================

eds:Receipt a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Research Receipt"@en ;
    rdfs:comment """R_E per charter §9. Answers: what hypothesis was tested,
what exact artifact executed, which source revision produced it, what
dependencies/config existed, what input/benchmark was used, what actually
executed, what outputs were observed, which validators interpreted them,
which proposition the evidence actually supports.""" .

eds:receiptClaim      a rdf:Property, owl:ObjectProperty   ; rdfs:domain eds:Receipt ; rdfs:range eds:ExecutableResearchClaim .
eds:receiptArtifact    a rdf:Property, owl:ObjectProperty   ; rdfs:domain eds:Receipt ; rdfs:range eds:Artifact .
eds:sourceRevision      a rdf:Property, owl:DatatypeProperty ; rdfs:domain eds:Receipt ; rdfs:range xsd:string ;
    rdfs:comment "Exact SHA per ~/CLAUDE.md discipline: base -> exact SHA, never a symbolic ref." .
eds:receiptEnvironment  a rdf:Property, owl:ObjectProperty   ; rdfs:domain eds:Receipt ; rdfs:range eds:Environment .
eds:receiptInputs       a rdf:Property, owl:DatatypeProperty ; rdfs:domain eds:Receipt ; rdfs:range rdfs:Literal .
eds:receiptExecution    a rdf:Property, owl:ObjectProperty   ; rdfs:domain eds:Receipt ; rdfs:range eds:Execution .
eds:receiptOutputs      a rdf:Property, owl:DatatypeProperty ; rdfs:domain eds:Receipt ; rdfs:range rdfs:Literal .
eds:receiptValidators   a rdf:Property, owl:DatatypeProperty ; rdfs:domain eds:Receipt ; rdfs:range xsd:string .
eds:receiptDigest       a rdf:Property, owl:DatatypeProperty ; rdfs:domain eds:Receipt ; rdfs:range xsd:string ;
    rdfs:comment "Content-address (sha256) of the canonicalized receipt body — makes the receipt itself independently checkable." .

# ===========================================================================
# 5. Program metrics — charter §21 (documented as data properties on a
#    ProgramSnapshot so metric history is itself an append-only series)
# ===========================================================================

eds:ProgramSnapshot a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Program Snapshot"@en ;
    rdfs:comment "One computed rollup of charter §21 metrics over a corpus of ERC records, at a point in time." .

eds:executableClaimRatio a rdf:Property, owl:DatatypeProperty ; rdfs:domain eds:ProgramSnapshot ; rdfs:range xsd:decimal .
eds:reproductionRatio    a rdf:Property, owl:DatatypeProperty ; rdfs:domain eds:ProgramSnapshot ; rdfs:range xsd:decimal .
eds:falsifierCoverage    a rdf:Property, owl:DatatypeProperty ; rdfs:domain eds:ProgramSnapshot ; rdfs:range xsd:decimal .
eds:receiptCoverage      a rdf:Property, owl:DatatypeProperty ; rdfs:domain eds:ProgramSnapshot ; rdfs:range xsd:decimal .
eds:knowledgeReuse       a rdf:Property, owl:DatatypeProperty ; rdfs:domain eds:ProgramSnapshot ; rdfs:range xsd:decimal .
eds:reasoningAmortization a rdf:Property, owl:DatatypeProperty ; rdfs:domain eds:ProgramSnapshot ; rdfs:range xsd:decimal .
