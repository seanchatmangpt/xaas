    eco:ownerCapability "RUNTIME_EXISTENCE" ;
    eco:projectionStanding "CANDIDATE" ;
    eco:authorityCeiling "CONSTRUCT" ;
    eco:forbidsCapability "CONSEQUENTIAL_ADMISSIBILITY" ;
    eco:forbidsRuntimePlacement "CONSEQUENCE_CROWN" .

