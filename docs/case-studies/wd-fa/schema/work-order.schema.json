{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Semantic Work Order",
  "type": "object",
  "required": [
    "identity",
    "title",
    "subject",
    "repository",
    "standing",
    "evidence_ceiling",
    "authority_requirement",
    "acceptance",
    "falsifiers"
  ],
  "properties": {
    "identity": {
      "pattern": "^SJ-[0-9]{3}$"
    },
    "title": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "repository": {
      "type": "string"
    },
    "standing": {
      "type": "string"
    },
    "evidence_ceiling": {
      "type": "string"
    },
    "authority_requirement": {
      "type": "string"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "falsifiers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
