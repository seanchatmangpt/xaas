wddeck:slide-08 a pres:Slide ;
  pres:slideOf wddeck:deck ;
  pres:id "slide-08" ;
  pres:order 8 ;
  pres:layout "split" ;
  pres:audience "interview" ;
  pres:title "Reasoning design: precompute corpus, decide on current facts" ;
  pres:notes "This is the cost and latency answer. I would not retrieve the last 200 documents into context. Corpus normalization, embeddings, image observations and known-case metadata are precomputed. Query time reconstructs the current failed drive, filters by ACL, retrieves candidate prior art, ranks hypotheses and then applies admission rules. For structured data, I prefer purpose-built tools over unrestricted text-to-SQL because the tool contract controls cost, joins, permissions and auditability." .

