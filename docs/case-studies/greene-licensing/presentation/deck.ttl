@prefix cs: <urn:xaas:case-study:> .
@prefix glc: <https://ggen.dev/ontology/greene-licensing-case#> .
@prefix gdeck: <https://ggen.dev/ontology/greene-licensing-case/deck#> .
@prefix pres: <https://ggen.dev/ns/presentation#> .

# The 10-slide proposal deck as pres: facts for pptx-presentation-pack
# (layouts from its admitted v0.1.0 vocabulary; its templates are used
# unchanged). The deck and every slide are also cs:Projection nodes of
# glc:case (see cs-pres-bridge.ttl): claim-bearing slides carry
# cs:rendersClaim, the others carry cs:noClaimReason. Each pres:blockOf
# sits on its own line so block-count verifiers can count source blocks.
# Own composition only; no source text.

gdeck:deck a pres:Presentation , cs:Projection ;
  cs:projectionOf glc:case ;
  cs:rendersClaim glc:c01 , glc:c02 , glc:c03 , glc:c04 , glc:c05 ;
  pres:id "greene-licensing-proposal-draft" ;
  pres:title "Licensing proposal draft: executable doctrine lab" ;
  pres:author "Sean Chatman" ;
  pres:company "Proposal draft (not sent)" ;
  pres:subject "Licensing proposal draft for an ordinal-indexed strategy lab" ;
  pres:footer "Proposal draft by Sean Chatman - not sent - authority NONE - evidence REPO_LOCAL_FIXTURE" .

gdeck:slide-01 a pres:Slide , cs:Projection ;
  pres:slideOf gdeck:deck ;
  cs:projectionOf glc:case ;
  cs:noClaimReason "Title slide; states the packet boundary only." ;
  pres:id "slide-01" ;
  pres:order 1 ;
  pres:layout "hero_flow" ;
  pres:audience "external" ;
  pres:kicker "LICENSING PROPOSAL DRAFT" ;
  pres:subtitle "An ordinal-indexed strategy lab with sealed, replayable receipts" ;
  pres:notes "Open by stating the boundary: this is a proposal draft by the author of the lab, nothing has been sent, and no license exists today." ;
  pres:title "Licensing proposal draft: executable doctrine lab" .

gdeck:slide-01-b01 a pres:Block ;
  pres:blockOf gdeck:slide-01 ;
  pres:order 1 ;
  pres:role "stage" ;
  pres:title "Ordinal index" ;
  pres:tone "blue" .
gdeck:slide-01-b02 a pres:Block ;
  pres:blockOf gdeck:slide-01 ;
  pres:order 2 ;
  pres:role "stage" ;
  pres:title "Own titles" ;
  pres:tone "blue" .
gdeck:slide-01-b03 a pres:Block ;
  pres:blockOf gdeck:slide-01 ;
  pres:order 3 ;
  pres:role "stage" ;
  pres:title "14 primitives" ;
  pres:tone "gold" .
gdeck:slide-01-b04 a pres:Block ;
  pres:blockOf gdeck:slide-01 ;
  pres:order 4 ;
  pres:role "stage" ;
  pres:title "Simulated worlds" ;
  pres:tone "green" .
gdeck:slide-01-b05 a pres:Block ;
  pres:blockOf gdeck:slide-01 ;
  pres:order 5 ;
  pres:role "stage" ;
  pres:title "Sealed receipts" ;
  pres:tone "green" .

gdeck:slide-02 a pres:Slide , cs:Projection ;
  pres:slideOf gdeck:deck ;
  cs:projectionOf glc:case ;
  cs:rendersClaim glc:c05 ;
  pres:id "slide-02" ;
  pres:order 2 ;
  pres:layout "bullets" ;
  pres:audience "external" ;
  pres:kicker "LICENSING PROPOSAL DRAFT" ;
  pres:notes "The catalog is my own operationalization. Point to the licensing non-claim carried in the catalog itself and to the no-excerpt gate." ;
  pres:title "What exists today" .

gdeck:slide-02-b01 a pres:Block ;
  pres:blockOf gdeck:slide-02 ;
  pres:order 1 ;
  pres:role "bullet" ;
  pres:body "33 entries indexed by ordinal, each with an own paraphrased title of 60 characters or fewer" .
gdeck:slide-02-b02 a pres:Block ;
  pres:blockOf gdeck:slide-02 ;
  pres:order 2 ;
  pres:role "bullet" ;
  pres:body "Own compositions over 14 primitive operators with five declared duals" .
gdeck:slide-02-b03 a pres:Block ;
  pres:blockOf gdeck:slide-02 ;
  pres:order 3 ;
  pres:role "bullet" ;
  pres:body "Six entries operationalized with ordered steps and falsifiers; 27 stubs" .
gdeck:slide-02-b04 a pres:Block ;
  pres:blockOf gdeck:slide-02 ;
  pres:order 4 ;
  pres:role "bullet" ;
  pres:body "The catalog carries a licensing non-claim and is gated against excerpts" .
gdeck:slide-02-b05 a pres:Block ;
  pres:blockOf gdeck:slide-02 ;
  pres:order 5 ;
  pres:role "conclusion" ;
  pres:body "No sentence of the book appears anywhere in the software or this deck" .

gdeck:slide-03 a pres:Slide , cs:Projection ;
  pres:slideOf gdeck:deck ;
  cs:projectionOf glc:case ;
  cs:noClaimReason "Mechanism overview; carries no evidence-bearing claim." ;
  pres:id "slide-03" ;
  pres:order 3 ;
  pres:layout "pipeline" ;
  pres:audience "external" ;
  pres:kicker "LICENSING PROPOSAL DRAFT" ;
  pres:notes "Walk the pipeline left to right. Every hop is software with receipts; none of it acts in the world." ;
  pres:title "How the lab works" .

gdeck:slide-03-b01 a pres:Block ;
  pres:blockOf gdeck:slide-03 ;
  pres:order 1 ;
  pres:role "stage" ;
  pres:title "Catalog" ;
  pres:body "Ordinal entries and compositions" ;
  pres:tone "blue" .
gdeck:slide-03-b02 a pres:Block ;
  pres:blockOf gdeck:slide-03 ;
  pres:order 2 ;
  pres:role "stage" ;
  pres:title "Policies" ;
  pres:body "One policy per operationalized entry" ;
  pres:tone "gold" .
gdeck:slide-03-b03 a pres:Block ;
  pres:blockOf gdeck:slide-03 ;
  pres:order 3 ;
  pres:role "stage" ;
  pres:title "Worlds" ;
  pres:body "Simulated competitive worlds and seeds" ;
  pres:tone "green" .
gdeck:slide-03-b04 a pres:Block ;
  pres:blockOf gdeck:slide-03 ;
  pres:order 4 ;
  pres:role "stage" ;
  pres:title "Ledger" ;
  pres:body "Hash-chained, signed episode records" ;
  pres:tone "stone" .
gdeck:slide-03-b05 a pres:Block ;
  pres:blockOf gdeck:slide-03 ;
  pres:order 5 ;
  pres:role "callout" ;
  pres:body "Authority NONE: the lab reads data and constructs reports only" .

gdeck:slide-04 a pres:Slide , cs:Projection ;
  pres:slideOf gdeck:deck ;
  cs:projectionOf glc:case ;
  cs:rendersClaim glc:c01 , glc:c03 ;
  pres:id "slide-04" ;
  pres:order 4 ;
  pres:layout "bullets" ;
  pres:audience "external" ;
  pres:kicker "LICENSING PROPOSAL DRAFT" ;
  pres:notes "Cite the exact autofde-lab commit d6becb59. Read the digests from the appendix, not from memory." ;
  pres:title "Run evidence at the bound commit" .

gdeck:slide-04-b01 a pres:Block ;
  pres:blockOf gdeck:slide-04 ;
  pres:order 1 ;
  pres:role "bullet" ;
  pres:body "252 episodes over 9 worlds and 2 seeds at autofde-lab d6becb59" .
gdeck:slide-04-b02 a pres:Block ;
  pres:blockOf gdeck:slide-04 ;
  pres:order 2 ;
  pres:role "bullet" ;
  pres:body "Ledger of 252 records, valid; tail digest f10e2294...c8665" .
gdeck:slide-04-b03 a pres:Block ;
  pres:blockOf gdeck:slide-04 ;
  pres:order 3 ;
  pres:role "bullet" ;
  pres:body "verify_run with replay: valid, zero failures" .
gdeck:slide-04-b04 a pres:Block ;
  pres:blockOf gdeck:slide-04 ;
  pres:order 4 ;
  pres:role "bullet" ;
  pres:body "Matrix digest 762fab0f...3ef7; report digest 5e4c530b...1cf3" .
gdeck:slide-04-b05 a pres:Block ;
  pres:blockOf gdeck:slide-04 ;
  pres:order 5 ;
  pres:role "conclusion" ;
  pres:body "Evidence ceiling REPO_LOCAL_FIXTURE; authority ceiling NONE" .

gdeck:slide-05 a pres:Slide , cs:Projection ;
  pres:slideOf gdeck:deck ;
  cs:projectionOf glc:case ;
  cs:rendersClaim glc:c02 ;
  pres:id "slide-05" ;
  pres:order 5 ;
  pres:layout "bullets" ;
  pres:audience "external" ;
  pres:kicker "LICENSING PROPOSAL DRAFT" ;
  pres:notes "Run the lab twice in separate processes and compare the file hashes live if time allows." ;
  pres:title "Reproducibility across processes" .

gdeck:slide-05-b01 a pres:Block ;
  pres:blockOf gdeck:slide-05 ;
  pres:order 1 ;
  pres:role "bullet" ;
  pres:body "report.json sha256 9f1d3a03...c6d4 in both processes" .
gdeck:slide-05-b02 a pres:Block ;
  pres:blockOf gdeck:slide-05 ;
  pres:order 2 ;
  pres:role "bullet" ;
  pres:body "ledger.jsonl sha256 e5d42b8a...030b in both processes" .
gdeck:slide-05-b03 a pres:Block ;
  pres:blockOf gdeck:slide-05 ;
  pres:order 3 ;
  pres:role "bullet" ;
  pres:body "Observation timestamps are pinned, so bytes do not drift between runs" .
gdeck:slide-05-b04 a pres:Block ;
  pres:blockOf gdeck:slide-05 ;
  pres:order 4 ;
  pres:role "conclusion" ;
  pres:body "Same commit, same inputs, same bytes" .

gdeck:slide-06 a pres:Slide , cs:Projection ;
  pres:slideOf gdeck:deck ;
  cs:projectionOf glc:case ;
  cs:rendersClaim glc:c04 ;
  pres:id "slide-06" ;
  pres:order 6 ;
  pres:layout "bullets" ;
  pres:audience "external" ;
  pres:kicker "LICENSING PROPOSAL DRAFT" ;
  pres:notes "Stress that these are model-relative observations of a fixture lab, not predictions about any real contest." ;
