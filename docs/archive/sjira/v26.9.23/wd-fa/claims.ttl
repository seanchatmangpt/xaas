@prefix wdc: <https://ggen-igniter.dev/sjira/v26.9.23/wd-fa/claims#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# WD FA claims ledger (lane V23-W, wave B1c; PRD section 9.2, the Friday G12
# deliverable). CANONICAL: docs/sjira/v26.9.23/wd-fa/proposal.md is rendered
# from this graph by `python3 scripts/sjira/wd_claims.py render` and checked by
# `wd_claims.py check` (ARD AR-002: the Markdown is a projection). Edit this
# file, re-render, re-check; never edit proposal.md by hand.
#
# Classes (PRD section 9.2): SUPPLIED | PUBLICLY_OBSERVABLE |
# ARCHITECTURAL_INFERENCE | WD_DEPENDENT_UNKNOWN, exactly one per claim.
#   SUPPLIED            evidenceKind "supplied-input" (wdc:quote verified in a
#                       wdc:suppliedSource whose sha256 a cited receipt names)
#                       or "observed-proof" (receipt standing ALIVE); every
#                       cited receipt must be ADMITTED by validate_receipt.py.
#   PUBLICLY_OBSERVABLE wdc:publicRef https URLs (PR, commit, CI run, standard).
#   ARCHITECTURAL_INFERENCE  wdc:premise claims (none WD_DEPENDENT_UNKNOWN,
#                       acyclic) + a wdc:reasoning chain.
#   WD_DEPENDENT_UNKNOWN  wdc:missingInput naming a declared wdc:MissingInput.
# A sentence matching a missing input's wdc:guardPattern must be
# WD_DEPENDENT_UNKNOWN naming that input, or a verified supplied quote.
#
# LLM edge (recorded): the claim sentences and their classification were
# written by llm:claude-opus-5-5@wave-B1c/V23-W (wdc:classifiedBy); the court
# that admits them (wd_claims.py check) is deterministic and runs no LLM.

wdc:ClaimClass a rdfs:Class ; rdfs:label "PRD section 9.2 claim class" .
wdc:SUPPLIED a wdc:ClaimClass ; rdfs:label "SUPPLIED" .
wdc:PUBLICLY_OBSERVABLE a wdc:ClaimClass ; rdfs:label "PUBLICLY_OBSERVABLE" .
wdc:ARCHITECTURAL_INFERENCE a wdc:ClaimClass ; rdfs:label "ARCHITECTURAL_INFERENCE" .
wdc:WD_DEPENDENT_UNKNOWN a wdc:ClaimClass ; rdfs:label "WD_DEPENDENT_UNKNOWN" .

# -- Missing Western Digital inputs (each claim that touches one is unknown) --

wdc:MI-mttr a wdc:MissingInput ;
    rdfs:label "Current MTTR by failure mode and how it is measured (the baseline)" ;
    wdc:guardPattern "\\bMTTR\\b|mean time to resolution" .
wdc:MI-data-access a wdc:MissingInput ;
    rdfs:label "Read access to the pilot corpus and the data lake (live data)" ;
    wdc:guardPattern "\\blive data\\b|data lake|\\bproduction data\\b" .
wdc:MI-qms a wdc:MissingInput ;
    rdfs:label "Whether QMS/MES write-back through an API is allowed in phase one" ;
    wdc:guardPattern "\\bQMS\\b|\\bMES\\b|quality[- ]system write-back" .
wdc:MI-brief-2a-2h a wdc:MissingInput ;
    rdfs:label "Real case content behind the internal brief sections 2a-2h (drives, lots, stations, cases, people)" ;
    wdc:guardPattern "\\b2[a-h]\\b|\\bA8[0-9]{2}\\b|\\bFM-[0-9]+|\\bL4[0-9]{2}\\b|\\bTS-[0-9]+|\\bFA-[0-9]{3}\\b|\\bMaya\\b" .
wdc:MI-authz-roles a wdc:MissingInput ;
    rdfs:label "Who may authorize closure and escalation" ;
    wdc:guardPattern "authori[sz]e closure|authorization roles|who may authori[sz]e" .
wdc:MI-rules a wdc:MissingInput ;
    rdfs:label "Western Digital's failure-mode catalogue with applicability conditions and falsifiers" ;
    wdc:guardPattern "failure-mode catalogue|Western Digital failure modes" .
wdc:MI-corpus a wdc:MissingInput ;
    rdfs:label "Size, age, formats and access rules of the Western Digital FA corpus" ;
    wdc:guardPattern "fifteen years|\\b15\\b[^.]*(years|yr)" .
wdc:MI-golden a wdc:MissingInput ;
    rdfs:label "A golden set of closed Western Digital FA cases and its time-slicing rule" ;
    wdc:guardPattern "golden set" .
wdc:MI-sponsor a wdc:MissingInput ;
    rdfs:label "A Western Digital sponsor's acceptance of the WBPR" ;
    wdc:guardPattern "Western Digital sponsor" .
wdc:MI-pilot-scope a wdc:MissingInput ;
    rdfs:label "Pilot product family, site and start date" ;
    wdc:guardPattern "pilot start date|pilot site" .

# -- Document skeleton ---------------------------------------------------------

wdc:proposal a wdc:Proposal ;
    dcterms:title "Western Digital FA Morning Brief: a bounded first-mile proposal" ;
    wdc:status "Status: DRAFT for operator review. The document render and the operator text freeze follow acceptance." ;
    wdc:preamble "Prepared for Western Digital failure analysis leadership. Every factual sentence below carries a ledger marker; the ledger says how each one is known." .

wdc:S01 a wdc:Section ; wdc:order 1 ; rdfs:label "Summary" ;
    wdc:body """{C1} {C2} {C3}

The rest of this summary states the open question. {C4} {C5} {C6}""" .

wdc:S02 a wdc:Section ; wdc:order 2 ; rdfs:label "How to read this proposal" ;
    wdc:body """Each sentence that states a fact, a count or an outcome ends with a marker that names one entry of the claims ledger. {C7} {C8}

- SUPPLIED: the claim is carried by an artifact supplied into this record and bound by a receipt that the fleet validator admits, either a quote checked against a digest-bound supplied text or an observed run whose receipt standing is ALIVE.
- PUBLICLY_OBSERVABLE: any reader can check the claim from a public pull request, commit or CI run, cited by URL.
- ARCHITECTURAL_INFERENCE: the claim follows from other ledger claims by a stated chain of reasoning, and none of its premises is unknown.
- WD_DEPENDENT_UNKNOWN: the claim depends on a Western Digital input that has not been supplied, and the ledger names that input.

{C9} {C10}""" .

wdc:S03 a wdc:Section ; wdc:order 3 ; rdfs:label "The problem as supplied" ;
    wdc:body """This section restates the problem as the supplied deck frames it. {C11} {C12} {C13}

{C14} {C15} {C16}

{C17} {C18}""" .

wdc:S04 a wdc:Section ; wdc:order 4 ; rdfs:label "The system the deck proposes" ;
    wdc:body """This section restates the design the deck proposes. {C19} {C20} {C21}

{C22} {C23} {C24} {C25}""" .

wdc:S05 a wdc:Section ; wdc:order 5 ; rdfs:label "The bounded future" ;
    wdc:body """This section summarizes the draft WBPR. {C26} {C27} {C28}

{C29} {C30} {C31} {C32}

{C33} {C34}""" .

wdc:S06 a wdc:Section ; wdc:order 6 ; rdfs:label "The reference loop" ;
    wdc:body """This section places the draft inside the release pipeline. {C35} {C36} {C37}

{C38} {C39} {C40}

{C41} {C42} {C43}

{C44} {C45}""" .

wdc:S07 a wdc:Section ; wdc:order 7 ; rdfs:label "What has been observed, with receipts" ;
    wdc:body """This section lists the runs made for this proposal and their receipts. {C46} {C47} {C48} {C49}

{C50} {C51}

