        "receipts/v26.9.23/V23-F.json", "HANDWRITTEN.md" ;
    sj:standing "UNKNOWN" ;
    sj:evidenceCeiling "EXECUTED_VERIFIED" ;
    sj:authorityCeiling "CONSTRUCT" ;
    sj:authorityRequirement "NONE" ;
    sj:promotionRule "Standing advances only from receipts/v26.9.23/V23-F.json ADMITTED by validate_receipt.py whose identity.tuple_digest equals this order's tuple digest; the sj:standing literal here is a shape placeholder the stop court never reads." ;
    sj:replayIdentity "semantic-jira:v26.9.23:V23-F" ;
    sj:requiresCourt v23:court-V23-F ;
    sj:requiresEvidence sj:local-execution-evidence, sj:receipt-evidence ;
    sj:requiresReceiptClass "verification" ;
    sj:acceptance v23:acceptance-V23-F ;
    sj:falsifier v23:falsifier-V23-F ;
    sj:projection sj:markdown-projection ;
    sj:nextAction v23:action-V23-F ;
    sj:nextCheckpoint v23:GC23-11 ;
    sj:checkpointOf v23:GC23-11 ;
    sj:postcondition "python3 scripts/sjira/fleet_matrix.py check-classification exits 0 on docs/sjira/v26.9.23/fleet/{classification.ttl,universe.json}: every universe repository has exactly one classification; courts/GC23-11.sh runs observe, emit, check-classification and check-standing." ;
    sj:requiresCapability v23:cap-construct-xaas-lane ;
    sj:evidenceHorizon "EXECUTED_VERIFIED" ;
    sj:exclusion "No LLM, network model API or zcode binary on any executed product path.",
        "No edit outside the lane worktree and this order's sj:pathScope; never another executor's worktree.",
        "Fleet repositories are observed only (fetch --no-prune, rev-parse, status); none is modified.",
        "Making every repository ALIVE is a non-goal (PRD section 10)." ;
    sj:consequenceClass "verification" ;
    sj:successorPolicy "discovered work that falsifies no GC23 proposition -> v23:GC-26.9.24" .
v23:court-V23-F a sj:Court ;
    rdfs:label "V23-F lane gate" ;
    dcterms:description "python3 -m unittest discover -s scripts/sjira -p 'test_fleet*.py' -v && python3 scripts/sjira/fleet_matrix.py check-classification --classification docs/sjira/v26.9.23/fleet/classification.ttl --universe docs/sjira/v26.9.23/fleet/universe.json, exit 0 at the exact subject." .
v23:acceptance-V23-F a sj:AcceptanceCriterion ;
    rdfs:label "V23-F acceptance" ;
    dcterms:description "An unclassified repository added to a temp universe makes check-classification exit 1 naming it (F7); a duplicate classification is refused; emit is byte-identical for identical inputs; check-standing refuses a receipt at a stale SHA." .
v23:falsifier-V23-F a sj:Falsifier ;
    rdfs:label "V23-F falsifier" ;
    dcterms:description "A universe repository without exactly one classification passes check-classification." .
v23:action-V23-F a sj:Action ;
    rdfs:label "Run the V23-F lane gate" ;
    dcterms:description "Run the lane gate and write receipts/v26.9.23/V23-F.json bound to this order's tuple digest." .

v23:WO-V23-C a sj:WorkOrder ;
    rdfs:label "V23-C admission and finite delta" ;
    dcterms:identifier "V23-C" ;
    dcterms:title "GC23-0/2/3 admission: candidates -> admitted semantics -> finite WorkOrder delta, and the GC23-3 shapes court" ;
    dcterms:description "Admit the V23-X candidates through SHACL in ggen_igniter mix semantic_jira.compile_prose, manufacture the deterministic delta and WorkOrder graph, and land the GC23-0, GC23-2 and GC23-3 courts. Depends on V23-X (in this graph) and on Friday lane FRI-T1 (G4 GoalCheckpoint vocabulary and shapes)." ;
    sj:repository "seanchatmangpt/ggen_igniter" ;
    sj:baseSha "5984ec480c2318e86aa621da5f496e5e014b0fac" ;
    sj:subject "ggen_igniter:semantic-jira-prose-admission" ;
    sj:pathScope "lib/ggen_igniter/semantic_jira/prose.ex", "lib/mix/tasks/semantic_jira.compile_prose.ex",
        "priv/ggen/semantic-jira-pack/", "test/",
        "xaas:docs/sjira/v26.9.23/courts/GC23-0.sh", "xaas:docs/sjira/v26.9.23/courts/GC23-2.sh",
        "xaas:docs/sjira/v26.9.23/courts/GC23-3.sh", "receipts/v26.9.23/V23-C.json" ;
    sj:standing "UNKNOWN" ;
    sj:evidenceCeiling "EXECUTED_VERIFIED" ;
    sj:authorityCeiling "CONSTRUCT" ;
    sj:authorityRequirement "NONE" ;
    sj:promotionRule "Standing advances only from receipts/v26.9.23/V23-C.json ADMITTED by validate_receipt.py whose identity.tuple_digest equals this order's tuple digest; the sj:standing literal here is a shape placeholder the stop court never reads." ;
    sj:replayIdentity "semantic-jira:v26.9.23:V23-C" ;
    sj:requiresCourt v23:court-V23-C ;
    sj:requiresEvidence sj:local-execution-evidence, sj:receipt-evidence ;
    sj:requiresReceiptClass "manufacture", "verification" ;
    sj:acceptance v23:acceptance-V23-C ;
    sj:falsifier v23:falsifier-V23-C ;
    sj:projection sj:markdown-projection ;
    sj:nextAction v23:action-V23-C ;
    sj:nextCheckpoint v23:GC23-3 ;
    sj:checkpointOf v23:GC23-2 ;
    sj:dependsOn v23:dep-V23-C-on-V23-X ;
    sj:postcondition "mix semantic_jira.compile_prose admits the V23-X candidates through Shacl.validate and replays admitted TTL -> WorkOrders twice byte-identical with no LLM reachable; the GC23-3 court validates docs/sjira/v26.9.23/goal.ttl with the pack shapes and refuses a WorkOrder with one mandatory tuple field deleted (F1)." ;
    sj:requiresCapability v23:cap-construct-ggen_igniter-lane ;
    sj:evidenceHorizon "EXECUTED_VERIFIED" ;
    sj:exclusion "No LLM, network model API or zcode binary on any executed product path.",
        "No edit outside the lane worktree and this order's sj:pathScope; never another executor's worktree.",
        "No second LLM interpretation of an admitted graph revision (ARD section 5.5)." ;
    sj:consequenceClass "manufacture" ;
    sj:successorPolicy "discovered work that falsifies no GC23 proposition -> v23:GC-26.9.24" .
v23:dep-V23-C-on-V23-X a sj:DependencyEdge ;
    rdfs:label "V23-C admits the V23-X candidate projection" ;
    sj:dependencyType "requiresProjection" ;
    sj:upstreamWorkOrder v23:WO-V23-X .
v23:court-V23-C a sj:Court ;
    rdfs:label "V23-C lane gate" ;
    dcterms:description "The ggen_igniter lane gate (format, compile --warnings-as-errors, the compile_prose and goal-checkpoint Chicago tests) plus sh docs/sjira/v26.9.23/courts/GC23-3.sh from the xaas root, exit 0 at the exact subjects." .
v23:acceptance-V23-C a sj:AcceptanceCriterion ;
    rdfs:label "V23-C acceptance" ;
    dcterms:description "Admission refuses an invalid candidate, the admitted TTL -> WorkOrder replay is byte-identical twice with LLM credentials unset, and deleting one mandatory tuple field of a goal.ttl order makes the GC23-3 court exit non-zero." .
v23:falsifier-V23-C a sj:Falsifier ;
    rdfs:label "V23-C falsifier" ;
    dcterms:description "A candidate enters the admitted graph without SHACL admission, the two replays differ, or F1 (a deleted tuple field) is admitted." .
v23:action-V23-C a sj:Action ;
    rdfs:label "Run the V23-C lane gate" ;
    dcterms:description "Run the lane gate and write receipts/v26.9.23/V23-C.json bound to this order's tuple digest." .

v23:WO-V23-B a sj:WorkOrder ;
