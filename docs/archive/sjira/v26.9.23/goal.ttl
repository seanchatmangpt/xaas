    sj:postcondition "mix xaas.stop_court --checkpoint GC-26.9.23 on the integration head reports every GC23 gate ALIVE, and the release receipt (ARD section 27) records LLM_INVOCATIONS_ON_KNOWN_REFERENCE_PATH = 0, UNRECEIPTED_ACTUATION = 0, REQUIRED_UNKNOWN = 0, UNCLASSIFIED_REQUIRED_WORK = 0 and STOP = true at exact repo SHAs with main CI green on those heads." ;
    sj:requiresCapability v23:cap-construct-xaas-lane ;
    sj:evidenceHorizon "EXECUTED_VERIFIED" ;
    sj:exclusion "No LLM, network model API or zcode binary on any executed product path.",
        "No edit outside the lane worktree and this order's sj:pathScope; never another executor's worktree.",
        "No registry publish (hex, crates, GHCR, Homebrew) and no deployment (PRD section 10: fully autonomous production deployment is a non-goal).",
        "Never rebase, force-push, reset --hard or merge with -X ours/theirs." ;
    sj:consequenceClass "publication" ;
    sj:successorPolicy "discovered work that falsifies no GC23 proposition -> v23:GC-26.9.24" .
