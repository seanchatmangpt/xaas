    sj:sourceStart 12761 ;
    sj:sourceEnd 13091 ;
    sj:sourceText "A goal is complete when:\n\n1. its required postconditions are observed;\n2. required dependencies have adequate standing;\n3. falsifiers do not fire;\n4. required receipts validate;\n5. replay requirements pass;\n6. no required hidden LLM/human edge remains;\n7. all remaining work is typed as successor, blocked, unsupported or refused." ;
    sj:boundaryClass sj:Core ;
    sj:requiredBy v23:GC23-11 ;
    sj:candidateStanding "UNKNOWN" ;
    sj:extractedBy "llm:claude-opus-5-5@wave-B0/V23-X" .

