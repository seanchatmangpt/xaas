@prefix sj: <https://ggen-igniter.dev/ontology/semantic-jira#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Canonical RDF for the v26.9.22 multi-repo wave: one sj:WorkOrder per lane work
# order, hosted by xaas (repository slugs are owner/name). Vocabulary is the
# semantic-jira-pack ontology; class and evidence-requirement definitions are
# verbatim from that pack. Standing is NOT asserted here: it is observed state,
# projected by generate.py from docs/sjira/v26.9.22/transition-log.jsonl
# (the TransitionLog projection) and standing/<identity>.json inputs.
# Generated tickets, wo.json and index.json are projections of this graph;
# edit this file, never a projection.

sj:WorkOrder a rdfs:Class .
sj:Court a rdfs:Class .
sj:EvidenceRequirement a rdfs:Class .
sj:AcceptanceCriterion a rdfs:Class .
sj:Falsifier a rdfs:Class .
sj:DependencyEdge a rdfs:Class .

sj:local-execution-evidence a sj:EvidenceRequirement ;
    rdfs:label "Local execution evidence" ;
    dcterms:description "Observed repository-local exact-subject execution evidence." .
sj:hosted-ci-evidence a sj:EvidenceRequirement ;
    rdfs:label "Hosted CI evidence" ;
    dcterms:description "Hosted CI evidence kept distinct from local execution." .
sj:receipt-evidence a sj:EvidenceRequirement ;
    rdfs:label "Receipt evidence" ;
    dcterms:description "Durable receipt evidence for the exact subject and transition." .
sj:replay-evidence a sj:EvidenceRequirement ;
    rdfs:label "Replay evidence" ;
    dcterms:description "Fresh replay over pack, dependency, graph, consequence, toolchain, and environment identities." .
sj:authority-evidence a sj:EvidenceRequirement ;
    rdfs:label "Authority evidence" ;
    dcterms:description "Prepared authority evidence for a consequential transition." .

<#WO-XAAS-26922-1> a sj:WorkOrder ;
    sj:identity "XAAS-26922-1" ;
    dcterms:title "Preserve work that is on no ref" ;
    dcterms:description "Commit each dirty worktree (auto/t3-sa2a-execute, auto/t6-ash-atlassian, auto/t4-dod-trust, errc/sj001-guard, errc/zcode-package-verify) on its own branch so nothing is lost." ;
    sj:subject "preserve-work-on-no-ref" ;
    sj:repository "seanchatmangpt/xaas" ;
    sj:baseSha "2d229c272c3a02dcb8e75ff600ea0a4edc058d71" ;
    sj:evidenceCeiling "EXECUTED_VERIFIED" ;
    sj:promotionRule "verified_by_required_courts_then_receipted" ;
    sj:replayIdentity "sjira-v26.9.22-XAAS-26922-1" ;
    sj:authorityRequirement "NONE" ;
    sj:requiredCourt "compile", "tests", "chicago_no_mocks" ;
    sj:requiredEvidence "command_exit_codes", "real_output" ;
    sj:acceptanceItem [ a sj:AcceptanceCriterion ; sj:index 0 ; dcterms:description "git -C <wt> status --porcelain | wc -l prints 0 for each of the five worktrees" ] ;
    sj:falsifierItem [ a sj:Falsifier ; sj:index 0 ; dcterms:description "standing promoted without observing the acceptance command's exit 0 against the exact subject" ], [ a sj:Falsifier ; sj:index 1 ; dcterms:description "evidence claimed without a durable receipt binding the subject SHA" ] ;
    sj:projection "jira", "verification", "receipt" ;
    sj:pathScope "worktrees/**" .

