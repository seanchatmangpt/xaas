    sj:courtCommand "env -u ZCODE_CLI_DIR -u ANTHROPIC_API_KEY -u ANTHROPIC_AUTH_TOKEN -u ANTHROPIC_BASE_URL -u ZAI_API_KEY mix test test/xaas/ultracode/recipe_worker_test.exs" ;
    sj:acceptance fri:G6-acceptance ;
    sj:falsifier fri:G6-falsifier .
fri:G6-acceptance a sj:AcceptanceCriterion ;
    rdfs:label "G6 acceptance" ;
    dcterms:description "The episode runs with ZCODE_CLI_DIR unset, no ANTHROPIC* or Z.AI credentials in env, and zcode binaries absent from PATH. The receipt's executor is recipe-worker, and the OCEL has zero LLM provider events." .
fri:G6-falsifier a sj:Falsifier ;
    rdfs:label "G6 falsifier" ;
    dcterms:description "An LLM credential or zcode on PATH during the episode does not produce a typed refusal." .

fri:G7 a sj:GoalCheckpoint ;
    dcterms:identifier "G7" ;
    rdfs:label "G7 Last-mile consequence" ;
    dcterms:description "xaas court_receipt.ex gains an exit_status format; target_suites.ex gains a ggen-igniter-format suite (mix format --check-formatted, receipt: true); semantic_receipt.ex passes through the court receipt's binding results for suites without an adapter; an R-projection of the xaas receipt is validated by validate_receipt.py." ;
