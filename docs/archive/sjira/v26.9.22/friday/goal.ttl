@prefix sj: <https://ggen-igniter.dev/ontology/semantic-jira#> .
@prefix fri: <https://ggen-igniter.dev/sjira/v26.9.22/friday#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# GC-FRI-0800: the governing object of the Friday 2026-09-25 08:00 PT stop
# court (plan: ~/.claude/plans/i-need-you-to-iterative-sedgewick.md; scope:
# /Users/sac/wt/v26922/COORDINATION.md "Friday Stop Court scope").
#
# Vocabulary: the semantic-jira-pack sj: namespace (ggen_igniter
# priv/ggen/semantic-jira-pack/ontology.ttl), including the Friday
# GoalCheckpoint contract (sj:GoalCheckpoint, sj:checkpointOf,
# sj:boundaryClass, sj:courtCommand, sj:stopQuery, sj:successorOf and the
# WorkOrder tuple sj:postcondition / sj:requiresCapability / sj:evidenceHorizon
# / sj:exclusion / sj:consequenceClass / sj:successorPolicy). Admission (G4):
# this graph merged with the pack ontology, validated by
# GgenIgniter.SemanticJira.Shacl against shapes/work-order.shacl.ttl.
#
# Law of this graph:
# - It never asserts a receipt, and the stop court ignores any sj:standing
#   written here: standing is observed, never declared. `mix xaas.stop_court`
#   runs each gate's sj:courtCommand from the xaas repository root, writes one
#   R-schema gate receipt per gate (docs/sjira/v26.9.22/friday/receipts/<G>.json),
#   projects the receipts ADMITTED by validate_receipt.py into sj:Receipt
#   nodes, and evaluates GC-FRI-0800's sj:stopQuery (= stop.rq) over this
#   graph plus those nodes. Exit 0 only when STOP=true.
# - Court commands for gates whose machinery lands later in the week are the
#   commands the plan names (they fail until then, so the gate stays UNKNOWN,
#   which is the correct standing). The lane that lands a gate's machinery
#   edits that gate's sj:courtCommand here; this graph is the source.
# - Discovered work that does not falsify one of G0..G12 is filed under the
#   successor GC-026923 and cannot hold this checkpoint open.
# - ${GGEN_IGNITER_DIR:-$HOME/ggen_igniter} in a court command names the
#   ggen_igniter checkout under judgement (the Friday integration worktree
#   before merge, ~/ggen_igniter after).

# ── Root and successor ──────────────────────────────────────────────────────

fri:GC-FRI-0800 a sj:GoalCheckpoint ;
    dcterms:identifier "GC-FRI-0800" ;
    rdfs:label "GC-FRI-0800 Friday 2026-09-25 08:00 PT stop court" ;
    dcterms:description "STOP(Fri0800) = G0 and ... and G12, subject to: everything left on the frontier is Successor, Blocked, Unsupported or Refused; no required item is UNKNOWN; no LLM is required on the steady-state KNOWN path. Completion is a finite semantic predicate compiled from accepted prose (Vision 2030 + the Friday WBPR), never 'no more work'." ;
    sj:baseSha "0d57147fc410444f2bf4608242e42075e2fea7c6" ;
    sj:exclusion "Discovered work that does not falsify one of G0..G12 is filed under GC-026923.",
        "ZOE Wednesday is a successor, not a Friday gate.",
        "No unbounded completion search and no inference of what arbitrary programs mean (Busy Beaver and Rice avoided by construction)." ;
    sj:courtCommand "mix xaas.stop_court --checkpoint GC-FRI-0800" ;
    sj:stopQuery """# STOP(GC-FRI-0800). True iff (1) GC-FRI-0800 has at least one child gate,
# (2) every child gate (sj:checkpointOf GC-FRI-0800) has a gate receipt with
# standing ALIVE, and (3) every WorkOrder with sj:checkpointOf GC-FRI-0800 is
# typed Successor (sj:boundaryClass sj:Successor) or has a receipt whose
# standing is terminal: ALIVE, BLOCKED, UNSUPPORTED or REFUSED. UNKNOWN,
# PARTIAL_ALIVE, BUILD_BROKEN or no receipt at all keeps STOP false.
# Receipts enter the graph only through mix xaas.stop_court, which projects
# receipts ADMITTED by validate_receipt.py as sj:Receipt nodes; goal.ttl
# itself may not assert any receipt. This text is byte-equal (trimmed) to the
# sj:stopQuery of GC-FRI-0800 in goal.ttl; the court refuses to run on drift.
PREFIX sj: <https://ggen-igniter.dev/ontology/semantic-jira#>
PREFIX dcterms: <http://purl.org/dc/terms/>
ASK {
  ?gc a sj:GoalCheckpoint ;
      dcterms:identifier "GC-FRI-0800" .
  FILTER EXISTS {
    ?anyGate a sj:GoalCheckpoint ;
             sj:checkpointOf ?gc .
  }
  FILTER NOT EXISTS {
    ?gate a sj:GoalCheckpoint ;
          sj:checkpointOf ?gc .
    FILTER NOT EXISTS {
      ?gate sj:receipt ?gateReceipt .
      ?gateReceipt a sj:Receipt ;
                   sj:standing "ALIVE" .
    }
  }
  FILTER NOT EXISTS {
    ?order a sj:WorkOrder ;
           sj:checkpointOf ?gc .
    FILTER NOT EXISTS { ?order sj:boundaryClass sj:Successor . }
    FILTER NOT EXISTS {
      ?order sj:receipt ?orderReceipt .
      ?orderReceipt a sj:Receipt ;
                    sj:standing ?standing .
      FILTER(?standing = "ALIVE" || STRSTARTS(?standing, "BLOCKED") || STRSTARTS(?standing, "UNSUPPORTED") || STRSTARTS(?standing, "REFUSED"))
    }
  }
}""" .

fri:GC-026923 a sj:GoalCheckpoint ;
    dcterms:identifier "GC-026923" ;
    rdfs:label "GC-026923 successor of the Friday checkpoint" ;
    dcterms:description "Successor goal that receives every item typed out of GC-FRI-0800: the 176 synthesized v26.9.22 orders, the 18 in-flight ZCode lane orders (L2-L8, L10), the remaining W1 law orders, the ultracode takeover runtime and watcher, the ggen-ecosystem crown laws, ZOE Wednesday, receipt-format conversion for non-critical repos, and xaas main SJ-010/011 (renumbered here). Its stop predicate is not compiled yet, so its stop query is false by construction." ;
    sj:successorOf fri:GC-FRI-0800 ;
    sj:boundaryClass sj:Successor ;
    sj:stopQuery """PREFIX sj: <https://ggen-igniter.dev/ontology/semantic-jira#>
# GC-026923 has no accepted prose yet: STOP is false by construction.
ASK { FILTER(false) }""" .

# ── Gates G0..G12 (plan section "Gates -> implementation -> court") ─────────

fri:G0 a sj:GoalCheckpoint ;
    dcterms:identifier "G0" ;
    rdfs:label "G0 Future bounded" ;
    dcterms:description "Vision = the accepted 2030 prose (the user decides which). WBPR = \"2026-09-25 Semantic Manufacturing Reference Loop\", drafted Tue night and accepted by the user Wed morning. Both live in xaas docs/sjira/v26.9.22/friday/{vision,wbpr}.md." ;
    sj:checkpointOf fri:GC-FRI-0800 ;
    sj:boundaryClass sj:FirstMile ;
    sj:exclusion "Operator acceptance of the WBPR is the one irreducible human edge; no court may stand in for it." ;
    sj:courtCommand """git ls-files --error-unmatch docs/sjira/v26.9.22/friday/vision.md docs/sjira/v26.9.22/friday/wbpr.md && grep -qF 'Status: **ACCEPTED' docs/sjira/v26.9.22/friday/wbpr.md""" ;
    sj:acceptance fri:G0-acceptance ;
    sj:falsifier fri:G0-falsifier .
fri:G0-acceptance a sj:AcceptanceCriterion ;
    rdfs:label "G0 acceptance" ;
    dcterms:description "Prose is committed, and each sentence maps to at least one proposition (G1)." .
fri:G0-falsifier a sj:Falsifier ;
    rdfs:label "G0 falsifier" ;
    dcterms:description "vision.md or wbpr.md is not committed, or wbpr.md still carries the DRAFT status line (no operator acceptance)." .

fri:G1 a sj:GoalCheckpoint ;
    dcterms:identifier "G1" ;
    rdfs:label "G1 Semantic closure" ;
    dcterms:description "Compile the WBPR into friday/propositions.ttl with these classes: Actor, Capability, Postcondition, Invariant, Exclusion, Falsifier, Evidence, BoundaryClass, Successor." ;
    sj:checkpointOf fri:GC-FRI-0800 ;
    sj:boundaryClass sj:FirstMile ;
    sj:courtCommand """F="$PWD/docs/sjira/v26.9.22/friday" && cd "${GGEN_IGNITER_DIR:-$HOME/ggen_igniter}" && mix semantic_jira.compile_prose --check "$F/wbpr.md" --propositions "$F/propositions.ttl\"""" ;
    sj:acceptance fri:G1-acceptance ;
    sj:falsifier fri:G1-falsifier .
fri:G1-acceptance a sj:AcceptanceCriterion ;
    rdfs:label "G1 acceptance" ;
    dcterms:description "SHACL admits it, and a SPARQL check finds zero propositions without a boundary class and no prose-only requirement." .
fri:G1-falsifier a sj:Falsifier ;
    rdfs:label "G1 falsifier" ;
    dcterms:description "A proposition without a boundary class, or a WBPR requirement present only as prose, is admitted." .

fri:G2 a sj:GoalCheckpoint ;
    dcterms:identifier "G2" ;
    rdfs:label "G2 Cold bootstrap" ;
    dcterms:description "New mix semantic_jira.bootstrap --fleet fleet.ttl in ggen_igniter. From durable artifacts only (git refs, TTL graphs, receipts, recipe registry, lease rules), it rebuilds subjects/SHAs, capabilities, authority, receipts and frontier (frontier_from_events)." ;
    sj:checkpointOf fri:GC-FRI-0800 ;
    sj:boundaryClass sj:Bootstrap ;
    sj:exclusion "No ~/.claude, chat transcript or LLM session is an input to the bootstrap." ;
    sj:courtCommand """F="$PWD/docs/sjira/v26.9.22/friday" && cd "${GGEN_IGNITER_DIR:-$HOME/ggen_igniter}" && a=$(env -i PATH="$PATH" HOME="$(mktemp -d)" mix semantic_jira.bootstrap --fleet "$F/fleet.ttl") && b=$(env -i PATH="$PATH" HOME="$(mktemp -d)" mix semantic_jira.bootstrap --fleet "$F/fleet.ttl") && test -n "$a" && test "$a" = "$b\"""" ;
    sj:acceptance fri:G2-acceptance ;
    sj:falsifier fri:G2-falsifier .
fri:G2-acceptance a sj:AcceptanceCriterion ;
    rdfs:label "G2 acceptance" ;
    dcterms:description "It runs under env -i HOME=$(mktemp -d) with no ~/.claude or chat. Its output digest matches a second independent run, and every critical-path frontier item is reconstructed." .
fri:G2-falsifier a sj:Falsifier ;
    rdfs:label "G2 falsifier" ;
    dcterms:description "The two cold runs differ, or a critical-path frontier item is missing from the reconstruction." .

fri:G3 a sj:GoalCheckpoint ;
    dcterms:identifier "G3" ;
    rdfs:label "G3 First-mile compiler" ;
    dcterms:description "New mix semantic_jira.compile_prose (ggen_igniter lib/ggen_igniter/semantic_jira/prose.ex). Pipeline: LLM candidate extraction (the only LLM edge; reuses the open-ontologies scaffold approach) -> Shacl.validate admission -> a deterministic delta, meaning propositions not yet witnessed by any receipt -> emitted sj:WorkOrders. The fresh example is the WD FA WBPR (see G12)." ;
    sj:checkpointOf fri:GC-FRI-0800 ;
    sj:boundaryClass sj:FirstMile ;
    sj:exclusion "The LLM candidate extraction is the only LLM edge; the admitted TTL -> orders replay has none." ;
    sj:courtCommand """F="$PWD/docs/sjira/v26.9.22/friday" && cd "${GGEN_IGNITER_DIR:-$HOME/ggen_igniter}" && a=$(env -u ANTHROPIC_API_KEY -u ANTHROPIC_AUTH_TOKEN -u ANTHROPIC_BASE_URL -u ZAI_API_KEY mix semantic_jira.compile_prose --replay "$F/wd-fa/admitted.ttl") && b=$(env -u ANTHROPIC_API_KEY -u ANTHROPIC_AUTH_TOKEN -u ANTHROPIC_BASE_URL -u ZAI_API_KEY mix semantic_jira.compile_prose --replay "$F/wd-fa/admitted.ttl") && test -n "$a" && test "$a" = "$b\"""" ;
    sj:acceptance fri:G3-acceptance ;
    sj:falsifier fri:G3-falsifier .
fri:G3-acceptance a sj:AcceptanceCriterion ;
    rdfs:label "G3 acceptance" ;
    dcterms:description "The admitted TTL -> orders run is replayed twice and is byte-identical with no LLM." .
fri:G3-falsifier a sj:Falsifier ;
    rdfs:label "G3 falsifier" ;
    dcterms:description "The two replays differ, or a replay reaches an LLM provider." .

fri:G4 a sj:GoalCheckpoint ;
    dcterms:identifier "G4" ;
    rdfs:label "G4 Finite work graph" ;
    dcterms:description "ggen_igniter ontology.ttl + shapes/work-order.shacl.ttl gain sj:postcondition, sj:requiresCapability, sj:evidenceHorizon, sj:exclusion, sj:consequenceClass, sj:successorPolicy. New sj:GoalCheckpoint (sj:checkpointOf, sj:boundaryClass, sj:stopQuery) is declared owl:equivalentClass gall-core gall:SemanticCheckpoint, with gall:Exclusion reused. Adds shapes for sj:Checkpoint, sj:GoalCheckpoint and sj:MachineExperience. Orders outside the goal graph are not required to carry the new fields." ;
    sj:checkpointOf fri:GC-FRI-0800 ;
    sj:boundaryClass sj:Core ;
    sj:courtCommand """GOAL="$PWD/docs/sjira/v26.9.22/friday/goal.ttl" && cd "${GGEN_IGNITER_DIR:-$HOME/ggen_igniter}" && GOAL="$GOAL" mix run --no-start -e 'g = RDF.Graph.add(GgenIgniter.Ontology.load!("priv/ggen/semantic-jira-pack/ontology.ttl"), GgenIgniter.Ontology.load!(System.fetch_env!("GOAL"))); r = GgenIgniter.SemanticJira.Shacl.validate_file(g); IO.puts("conforms=#{r.conforms} violations=#{length(r.violations)}"); unless r.conforms, do: System.halt(1)' && mix test test/ggen_igniter_semantic_jira_goal_checkpoint_test.exs""" ;
    sj:acceptance fri:G4-acceptance ;
    sj:falsifier fri:G4-falsifier .
fri:G4-acceptance a sj:AcceptanceCriterion ;
    rdfs:label "G4 acceptance" ;
    dcterms:description "The SHACL court passes on goal.ttl. Mutation check: dropping any tuple field from one order must be refused." .
fri:G4-falsifier a sj:Falsifier ;
    rdfs:label "G4 falsifier" ;
    dcterms:description "Dropping a tuple field from one GC-FRI-0800 order is not refused." .

fri:G5 a sj:GoalCheckpoint ;
    dcterms:identifier "G5" ;
    rdfs:label "G5 SA2A conservation" ;
    dcterms:description "xaas lib/xaas/sa2a/route.ex. The SA2A request is SemanticA2A.task_from_work_order (ggen_igniter). Capability -> provider resolution goes through a capability registry (config :xaas, :ultracode_construction_recipes). A tuple digest over (subject, postcondition, capability, evidence ceiling, authority ceiling, consequence class, exclusions) is computed at the sJira -> SA2A -> XaaS epoch hops." ;
    sj:checkpointOf fri:GC-FRI-0800 ;
    sj:boundaryClass sj:Core ;
    sj:courtCommand "mix test test/xaas/sa2a/route_test.exs" ;
    sj:acceptance fri:G5-acceptance ;
