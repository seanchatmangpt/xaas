    sj:acceptance fri:G7-acceptance ;
    sj:falsifier fri:G7-falsifier .
fri:G7-acceptance a sj:AcceptanceCriterion ;
    rdfs:label "G7 acceptance" ;
    dcterms:description "The independent observer (Verifier guarded run: clean tree, same head) checks the postcondition. The falsifier (reverting the commit makes the court fail) holds. The R-projection is ADMITTED, and the OCEL event exists (mix xaas.export_ocel)." .
fri:G7-falsifier a sj:Falsifier ;
    rdfs:label "G7 falsifier" ;
    dcterms:description "Reverting the recipe commit does not make the court fail." .

fri:G8 a sj:GoalCheckpoint ;
    dcterms:identifier "G8" ;
    rdfs:label "G8 Closed frontier" ;
    dcterms:description "SemanticCrown.drive/1, extracted from loop/execute/finish/frontier with the repo slug as a parameter and the APS sense/seed dropped. It chains descriptor -> materialize -> RecipeWorker -> xaas.semantic.receipt -> semantic_jira.xaas_receipt -> reconcile -> frontier." ;
    sj:checkpointOf fri:GC-FRI-0800 ;
    sj:boundaryClass sj:LastMile ;
    sj:courtCommand "mix test test/xaas/ultracode/semantic_crown_drive_test.exs" ;
    sj:acceptance fri:G8-acceptance ;
    sj:falsifier fri:G8-falsifier .
fri:G8-acceptance a sj:AcceptanceCriterion ;
    rdfs:label "G8 acceptance" ;
    dcterms:description "Before/after frontier diff: the order leaves the frontier and its dependent enters it. This is recorded in the TransitionLog." .
fri:G8-falsifier a sj:Falsifier ;
    rdfs:label "G8 falsifier" ;
    dcterms:description "The executed order stays on the frontier, or its dependent does not enter it." .

fri:G9 a sj:GoalCheckpoint ;
    dcterms:identifier "G9" ;
    rdfs:label "G9 Learning ratchet" ;
    dcterms:description "Episode 1: format drift on subject S1 with no admitted route is UNKNOWN; a bounded exploration resolves it; the result is SemanticJira.machine_experience/1 -> an admitted route (failure_class -> capability recipe:mix-format) in the graph. Episode 2: format drift on a different subject S2 routes as KNOWN (autofde-lab episode1/episode2/equivalence pattern)." ;
    sj:checkpointOf fri:GC-FRI-0800 ;
    sj:boundaryClass sj:Core ;
    sj:courtCommand "mix test test/xaas/ultracode/learning_ratchet_test.exs" ;
    sj:acceptance fri:G9-acceptance ;
    sj:falsifier fri:G9-falsifier .
fri:G9-acceptance a sj:AcceptanceCriterion ;
    rdfs:label "G9 acceptance" ;
    dcterms:description "Two-episode court: episode 2 has 0 LLM invocations and fewer steps than episode 1, both from the OCEL. The route came from the admitted MachineExperience, not from a literal." .
fri:G9-falsifier a sj:Falsifier ;
    rdfs:label "G9 falsifier" ;
    dcterms:description "Episode 2 invokes an LLM, takes at least as many steps as episode 1, or routes from a literal instead of the admitted MachineExperience." .

fri:G10 a sj:GoalCheckpoint ;
    dcterms:identifier "G10" ;
    rdfs:label "G10 Replay" ;
    dcterms:description "SemanticCrown.replay/2 becomes directory-aware (ledger dir), plus SemanticJira.replay_check/2 KNOWN_REPLAY." ;
    sj:checkpointOf fri:GC-FRI-0800 ;
    sj:boundaryClass sj:Bootstrap ;
    sj:exclusion "No transcript access during replay." ;
    sj:courtCommand """a=$(env -i PATH="$PATH" HOME="$(mktemp -d)" mix xaas.semantic.crown --replay docs/sjira/v26.9.22/friday/ledger) && b=$(env -i PATH="$PATH" HOME="$(mktemp -d)" mix xaas.semantic.crown --replay docs/sjira/v26.9.22/friday/ledger) && test -n "$a" && test "$a" = "$b\"""" ;
    sj:acceptance fri:G10-acceptance ;
    sj:falsifier fri:G10-falsifier .
fri:G10-acceptance a sj:AcceptanceCriterion ;
    rdfs:label "G10 acceptance" ;
    dcterms:description "A cold process (env -i, fresh HOME) recomputes standing and frontier from receipts plus the TransitionLog, byte-identical, with no transcript access." .
fri:G10-falsifier a sj:Falsifier ;
    rdfs:label "G10 falsifier" ;
    dcterms:description "Deleting a receipt does not make the replay diverge." .

fri:G11 a sj:GoalCheckpoint ;
    dcterms:identifier "G11" ;
    rdfs:label "G11 Per-repo bounded standing" ;
    dcterms:description "Generated matrix friday/repo-matrix.ttl plus a markdown projection from receipts and court verdicts. Critical path = ggen_igniter + xaas (+ ash_a2a only if Gall.Capability is used). Every other repo is classified Successor / Blocked / Unsupported / Refused, with the exact SHA and evidence ceiling." ;
    sj:checkpointOf fri:GC-FRI-0800 ;
    sj:boundaryClass sj:LastMile ;
    sj:courtCommand """test -s docs/sjira/v26.9.22/friday/repo-matrix.ttl && test -s docs/sjira/v26.9.22/friday/repo-matrix.md && test "$(gh run list --repo seanchatmangpt/xaas --branch main --limit 1 --json conclusion --jq '.[0].conclusion')" = success && test "$(gh run list --repo seanchatmangpt/ggen_igniter --branch main --limit 1 --json conclusion --jq '.[0].conclusion')" = success""" ;
    sj:acceptance fri:G11-acceptance ;
