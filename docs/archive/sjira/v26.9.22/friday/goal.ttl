fri:G5-acceptance a sj:AcceptanceCriterion ;
    rdfs:label "G5 acceptance" ;
    dcterms:description "Digests are equal at every hop. Mutating one field at any hop is refused as broken_term: admission_vacuous." .
fri:G5-falsifier a sj:Falsifier ;
    rdfs:label "G5 falsifier" ;
    dcterms:description "A tuple digest mutated at one hop is admitted." .

