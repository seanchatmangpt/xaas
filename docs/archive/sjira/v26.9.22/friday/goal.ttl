fri:G11-falsifier a sj:Falsifier ;
    rdfs:label "G11 falsifier" ;
    dcterms:description "An unclassified repo does not make G11 fail." .

fri:G12 a sj:GoalCheckpoint ;
    dcterms:identifier "G12" ;
    rdfs:label "G12 WD deliverable" ;
    dcterms:description "5-8 pages compiled from the G3 WD FA semantic graph. Sources: the FA Case Study deck, autofde-lab wd_fa court (PR #170, eb93405c), xaas WD-CS2 (PR #61), marketplace WD FA packs (#474). Every claim gets a class: observed proof (receipt-linked), bounded architectural inference, or WD-dependent UNKNOWN (MTTR baseline, live data, QMS write-back)." ;
    sj:checkpointOf fri:GC-FRI-0800 ;
    sj:boundaryClass sj:LastMile ;
    sj:exclusion "WD brief sections 2a-2h are WD-dependent UNKNOWN unless the user supplies them." ;
    sj:courtCommand """test -s docs/sjira/v26.9.22/friday/wd/proposal.md && grep -qF 'Status: **FROZEN' docs/sjira/v26.9.22/friday/wd/proposal.md && python3 docs/sjira/v26.9.22/friday/wd/claims_court.py docs/sjira/v26.9.22/friday/wd/claims-ledger.json""" ;
    sj:acceptance fri:G12-acceptance ;
    sj:falsifier fri:G12-falsifier .
fri:G12-acceptance a sj:AcceptanceCriterion ;
    rdfs:label "G12 acceptance" ;
    dcterms:description "A claims ledger: every sentence carrying a claim is linked to a class, and every observed-proof claim has a validating receipt. The user freezes the text Thu." .
fri:G12-falsifier a sj:Falsifier ;
    rdfs:label "G12 falsifier" ;
    dcterms:description "A claim-bearing sentence has no class, or an observed-proof claim has no ADMITTED receipt." .

# ── Critical-path work orders (tuple-complete, sj:checkpointOf GC-FRI-0800) ─

fri:cap-construct-xaas-mix-task a sj:Capability ;
    rdfs:label "Construct: xaas mix task" ;
    dcterms:description "Hand construction of an xaas Mix task and its Chicago tests; no generator renders a stop-court runner (UNSUPPORTED(generator-capability), HANDWRITTEN.md)." ;
    sj:capabilityId "construct:xaas-mix-task" .

fri:WO-FRI-T5 a sj:WorkOrder ;
    rdfs:label "FRI-T5 Stop court runner and governing graph" ;
    dcterms:identifier "FRI-T5" ;
    dcterms:title "Stop court runner and GC-FRI-0800 governing graph" ;
    dcterms:description "Author goal.ttl (GC-FRI-0800 with gates G0..G12 and successor GC-026923) and stop.rq, and build mix xaas.stop_court: run each gate's court command with a timeout, write one R-schema gate receipt per gate, evaluate the stop query over the graph plus admitted receipts, print the per-gate table and STOP, exit 0 only when STOP=true. No LLM anywhere." ;
    sj:repository "seanchatmangpt/xaas" ;
    sj:baseSha "0d57147fc410444f2bf4608242e42075e2fea7c6" ;
    sj:subject "xaas:stop-court-runner" ;
    sj:pathScope "docs/sjira/v26.9.22/friday/goal.ttl", "docs/sjira/v26.9.22/friday/stop.rq",
        "lib/mix/tasks/xaas.stop_court.ex", "test/mix/tasks/xaas_stop_court_test.exs",
        "receipts/v26.9.22/FRI-T5.json", "HANDWRITTEN.md" ;
    sj:standing "UNKNOWN" ;
    sj:evidenceCeiling "EXECUTED_VERIFIED" ;
    sj:authorityCeiling "CONSTRUCT" ;
    sj:authorityRequirement "NONE" ;
    sj:promotionRule "Standing advances only from receipts/v26.9.22/FRI-T5.json ADMITTED by validate_receipt.py whose identity.tuple_digest equals this order's tuple digest; the sj:standing literal here is never read by the stop court." ;
    sj:replayIdentity "semantic-jira:v26.9.22:FRI-T5" ;
    sj:requiresCourt fri:court-FRI-T5 ;
    sj:requiresEvidence sj:local-execution-evidence, sj:receipt-evidence ;
    sj:requiresReceiptClass "manufacture", "verification" ;
    sj:acceptance fri:acceptance-FRI-T5 ;
    sj:falsifier fri:falsifier-FRI-T5-vacuous, fri:falsifier-FRI-T5-asserted ;
    sj:projection sj:markdown-projection ;
    sj:nextAction fri:action-FRI-T5 ;
    sj:nextCheckpoint fri:GC-FRI-0800 ;
    sj:checkpointOf fri:GC-FRI-0800 ;
    sj:postcondition "mix xaas.stop_court over a two-gate goal graph exits 1 with STOP=false when one court command fails and exits 0 with STOP=true when both pass; every gate receipt it writes is ADMITTED by validate_receipt.py; a missing gate receipt keeps STOP=false." ;
    sj:requiresCapability fri:cap-construct-xaas-mix-task ;
    sj:evidenceHorizon "EXECUTED_VERIFIED" ;
    sj:exclusion "No LLM anywhere in the stop court path.",
        "No gate is promoted without its court command's observed exit 0.",
        "The goal graph never asserts a receipt, and its sj:standing literals are never read." ;
    sj:consequenceClass "manufacture" ;
    sj:successorPolicy "Gate court commands whose machinery lands later in the week are refined in this graph by their owning lanes; stop-court features not needed to evaluate STOP(GC-FRI-0800) are filed under GC-026923." .

fri:court-FRI-T5 a sj:Court ;
    rdfs:label "FRI-T5 lane gate" ;
    dcterms:description "mix format --check-formatted && MIX_ENV=test mix compile --force --warnings-as-errors && mix test test/mix/tasks/xaas_stop_court_test.exs, exit 0 at the exact subject." .
fri:acceptance-FRI-T5 a sj:AcceptanceCriterion ;
    rdfs:label "FRI-T5 acceptance" ;
    dcterms:description "Chicago tests over real tmp git repos, real shell court commands and the real validator: 'true' + 'false' -> STOP=false, exit 1, both receipts ADMITTED; 'true' + 'true' -> STOP=true, exit 0; a missing gate receipt -> STOP=false." .
fri:falsifier-FRI-T5-vacuous a sj:Falsifier ;
    rdfs:label "FRI-T5 vacuous stop" ;
    dcterms:description "STOP=true is printed, or the court exits 0, while some gate of the checkpoint has no ADMITTED receipt with standing ALIVE." .
fri:falsifier-FRI-T5-asserted a sj:Falsifier ;
    rdfs:label "FRI-T5 asserted receipt" ;
    dcterms:description "A receipt or ALIVE standing asserted inside the goal graph itself changes the stop verdict instead of being refused." .
fri:action-FRI-T5 a sj:Action ;
    rdfs:label "Run the FRI-T5 lane gate" ;
    dcterms:description "Run the lane gate and write receipts/v26.9.22/FRI-T5.json bound to this order's tuple digest." .
