@prefix sj: <https://ggen-igniter.dev/ontology/semantic-jira#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Canonical RDF for the v26.9.22 multi-repo Semantic Jira work graph (16 repositories,
# 153 work orders). Vocabulary: semantic-jira-pack (ggen_igniter, pack 26.9.19).
# This graph is the source; wo.json, index.json and jira/*.md are projections (project.py).
# Standing is UNKNOWN for every order here: observed standing comes from the TransitionLog
# (GGEN_IGNITER-26922-06/07), never from a literal edited into a projection.
# baseSha = exact release/v26.9.22 integration head of each repository at authoring time.

sj:WorkOrder a rdfs:Class .
sj:Court a rdfs:Class .
sj:EvidenceRequirement a rdfs:Class .
sj:AcceptanceCriterion a rdfs:Class .
sj:Falsifier a rdfs:Class .
sj:Action a rdfs:Class .
sj:Checkpoint a rdfs:Class .
sj:ProjectionSpec a rdfs:Class .
sj:DependencyEdge a rdfs:Class .

sj:source-evidence a sj:EvidenceRequirement ;
    rdfs:label "Source evidence" ;
    dcterms:description "Exact canonical-source identity evidence." .
sj:generated-artifact-evidence a sj:EvidenceRequirement ;
    rdfs:label "Generated artifact evidence" ;
    dcterms:description "Evidence binding a consequence to semantic source and generator." .
sj:local-execution-evidence a sj:EvidenceRequirement ;
    rdfs:label "Local execution evidence" ;
    dcterms:description "Observed repository-local exact-subject execution evidence." .
sj:hosted-ci-evidence a sj:EvidenceRequirement ;
    rdfs:label "Hosted CI evidence" ;
    dcterms:description "Hosted CI evidence kept distinct from local execution." .
sj:postcondition-evidence a sj:EvidenceRequirement ;
    rdfs:label "Postcondition evidence" ;
    dcterms:description "Independent evidence that the required consequence holds." .
sj:authority-evidence a sj:EvidenceRequirement ;
    rdfs:label "Authority evidence" ;
    dcterms:description "Prepared authority evidence for a consequential transition." .
sj:receipt-evidence a sj:EvidenceRequirement ;
    rdfs:label "Receipt evidence" ;
    dcterms:description "Durable receipt evidence for the exact subject and transition." .
sj:replay-evidence a sj:EvidenceRequirement ;
    rdfs:label "Replay evidence" ;
    dcterms:description "Fresh replay over pack, dependency, graph, consequence, toolchain, and environment identities." .
sj:publication-evidence a sj:EvidenceRequirement ;
    rdfs:label "Publication evidence" ;
    dcterms:description "Publication evidence distinct from implementation and verification." .

sj:projection-jira a sj:ProjectionSpec ;
    rdfs:label "Jira/Markdown ticket" ;
    dcterms:description "Deterministic jira/markdown ticket projection; authority is NONE." ;
    sj:projectionType "jira" ;
    sj:extension "md" ;
    sj:generatorIdentity "ggen_igniter:semantic-jira-pack@26.9.19" ;
    sj:authorityClaim "NONE" .
sj:projection-sa2a a sj:ProjectionSpec ;
    rdfs:label "SA2A work/execution package" ;
    dcterms:description "Deterministic sa2a work/execution package projection; authority is NONE." ;
    sj:projectionType "sa2a" ;
    sj:extension "json" ;
    sj:generatorIdentity "ggen_igniter:semantic-jira-pack@26.9.19" ;
    sj:authorityClaim "NONE" .
sj:projection-worker a sj:ProjectionSpec ;
    rdfs:label "Bounded worker input envelope" ;
    dcterms:description "Deterministic bounded worker input envelope projection; authority is NONE." ;
    sj:projectionType "worker" ;
    sj:extension "json" ;
    sj:generatorIdentity "ggen_igniter:semantic-jira-pack@26.9.19" ;
    sj:authorityClaim "NONE" .
sj:projection-verification a sj:ProjectionSpec ;
    rdfs:label "Verification plan" ;
    dcterms:description "Deterministic verification plan projection; authority is NONE." ;
    sj:projectionType "verification" ;
    sj:extension "json" ;
    sj:generatorIdentity "ggen_igniter:semantic-jira-pack@26.9.19" ;
    sj:authorityClaim "NONE" .
sj:projection-machine a sj:ProjectionSpec ;
    rdfs:label "Machine status view" ;
    dcterms:description "Deterministic machine status view projection; authority is NONE." ;
    sj:projectionType "machine" ;
    sj:extension "json" ;
    sj:generatorIdentity "ggen_igniter:semantic-jira-pack@26.9.19" ;
    sj:authorityClaim "NONE" .
sj:projection-receipt a sj:ProjectionSpec ;
    rdfs:label "Receipt requirement summary" ;
    dcterms:description "Deterministic receipt requirement summary projection; authority is NONE." ;
    sj:projectionType "receipt" ;
    sj:extension "json" ;
    sj:generatorIdentity "ggen_igniter:semantic-jira-pack@26.9.19" ;
    sj:authorityClaim "NONE" .
sj:projection-replay a sj:ProjectionSpec ;
    rdfs:label "Replay manifest" ;
    dcterms:description "Deterministic replay manifest projection; authority is NONE." ;
    sj:projectionType "replay" ;
    sj:extension "json" ;
    sj:generatorIdentity "ggen_igniter:semantic-jira-pack@26.9.19" ;
    sj:authorityClaim "NONE" .

# ---- per-repository release checkpoints (release_action of the v26.9.22 synthesis) ----
sj:cp-ggen-igniter-v26922-release a sj:Checkpoint ;
    rdfs:label "seanchatmangpt/ggen_igniter v26.9.22 release checkpoint" ;
    dcterms:description "Closes the v26.9.22 cycle for seanchatmangpt/ggen_igniter (integration head facdf0dbd3cd95f5b8a630dcbcacc0140d6582fc on release/v26.9.22 at authoring). Release action: Bump mix.exs to 26.9.22 (HEAD says 26.9.20; main and hex say 26.9.15). Add a CHANGELOG `## v26.9.22` heading so doctor check 17 passes. Tag v26.9.22 on the green integration merge, since no v26.9.20 or v26.9.21 tags exist. Publish to hex so xaas, beam4pm and ash_surface can drop path and hex-26.9.15 pins. Commit docs/jira/v26.9.22, generated from a committed day.ttl, following the repo's own calver-ticket-day practice." .
sj:cp-xaas-v26922-release a sj:Checkpoint ;
    rdfs:label "seanchatmangpt/xaas v26.9.22 release checkpoint" ;
    dcterms:description "Closes the v26.9.22 cycle for seanchatmangpt/xaas (integration head 77887a6453e1ca5c15b8fdbf1081f6791daa9083 on release/v26.9.22 at authoring). Release action: Change VERSION from 26.9.17 to 26.9.22 (mix.exs reads @version from it). Create the first CalVer git tag, v26.9.22, on a gate-green main. Create docs/sjira/v26.9.22 as a TTL-first multi-repo graph (work-orders.ttl, generated projections, index.json, admit.exs, sa2a_loop.exs, receipts/) to replace the v26.9.21 generate.py literal pattern. Keep docs/sjira/v26.9.21 as the historical cycle, with standings reconciled." .
sj:cp-zcode-cli-v26922-release a sj:Checkpoint ;
    rdfs:label "seanchatmangpt/zcode-cli v26.9.22 release checkpoint" ;
    dcterms:description "Closes the v26.9.22 cycle for seanchatmangpt/zcode-cli (integration head da178249d54b0c2f8a34977d694300c1f039e7da on release/v26.9.22 at authoring). Release action: The repo uses upstream semver tags (v3.x-NN), not CalVer. After merging upstream, bump package.json to the 3.14.1-27 line with the lock and vendor at 3.14.1, and do not create a v26.9.22 git tag. The v26.9.22 cycle lives in docs/sjira/v26.9.22 (work-orders.ttl plus generated jira/prd/ard/wbpr/plan/execution plus receipts), following the existing docs/sjira/v26.9.21 practice. Merge and push stay human steps per README unless the user grants them." .
sj:cp-ash-a2a-v26922-release a sj:Checkpoint ;
    rdfs:label "seanchatmangpt/ash_a2a v26.9.22 release checkpoint" ;
    dcterms:description "Closes the v26.9.22 cycle for seanchatmangpt/ash_a2a (integration head 971687469ea2ac04f27a4cb2d1af40bf957c4b63 on release/v26.9.22 at authoring). Release action: Change mix.exs 26.9.21 -> 26.9.22 and add a CHANGELOG [26.9.22] section. Tag annotated v26.9.22 only on a CI-green exact subject (v26.9.18 and v26.9.20 were never tagged), then hex-publish so xaas (locked 26.9.12), beam4pm (26.9.21), ggen_igniter (26.9.17) and ash_surface (git e25ed6e) can consume it. There is no docs/sjira folder, since the repo only archives docs/jira; its orders go in the xaas v26.9.22 graph." .
sj:cp-autofde-lab-v26922-release a sj:Checkpoint ;
    rdfs:label "seanchatmangpt/autofde-lab v26.9.22 release checkpoint" ;
    dcterms:description "Closes the v26.9.22 cycle for seanchatmangpt/autofde-lab (integration head d4faeff92c8000fcea53b065ef2c833b7070446b on release/v26.9.22 at authoring). Release action: Version comes from setuptools_scm via git describe (currently v26.9.17-108). Tag v26.9.22 only once ci.yml 'Full qualification and release' is green on master and the SA2A receipts name the exact subject. No v26.9.18..21 tags exist. The v26.9.22 work orders live in the xaas v26.9.22 graph with repository=seanchatmangpt/autofde-lab, matching how SJ-006 was hosted. Commit the local docs/jira/v26.9.19 and add docs/jira/v26.9.22 only as a pointer, following the repo's docs/jira/vX practice." .
sj:cp-ggen-marketplace-v26922-release a sj:Checkpoint ;
    rdfs:label "seanchatmangpt/ggen-marketplace v26.9.22 release checkpoint" ;
    dcterms:description "Closes the v26.9.22 cycle for seanchatmangpt/ggen-marketplace (integration head 57b4d330237db0f51b17ac1991f8f5da43f085f4 on release/v26.9.22 at authoring). Release action: Releases are cut by publish.yml from marketplace.toml [marketplace].version, not by manual tags; v26.9.14 is an orphan tag. Set version = \"v26.9.22\" (it currently says v26.9.13) after publish.yml and pages.yml are green. Commit the untracked docs/jira/v26.9.19. The v26.9.22 work orders live in the xaas v26.9.22 graph with repository=seanchatmangpt/ggen-marketplace; PR #474's WORKGRAPH is superseded or folded in." .
sj:cp-ggen-v26922-release a sj:Checkpoint ;
    rdfs:label "seanchatmangpt/ggen v26.9.22 release checkpoint" ;
    dcterms:description "Closes the v26.9.22 cycle for seanchatmangpt/ggen (integration head 06093e0cd679662b8c6d15eedea0973fd475dec5 on release/v26.9.22 at authoring). Release action: ggen release numbers are a sequential patch counter, not the date, so this cycle's release is v26.9.13 (the latest is v26.9.12) cut by the release pipeline. Fix the Homebrew tap formula so consumers stop running 26.8.18. There is no ggen-owned docs/sjira folder; ggen's v26.9.22 orders go in the xaas graph (repository=seanchatmangpt/ggen), and the untracked docs/jira/v26.9.19 survey is committed or removed." .
sj:cp-gymact-v26922-release a sj:Checkpoint ;
    rdfs:label "seanchatmangpt/gymact v26.9.22 release checkpoint" ;
    dcterms:description "Closes the v26.9.22 cycle for seanchatmangpt/gymact (integration head a2d2b07dd51e6a4f8689e6c86a7d867293bbf473 on release/v26.9.22 at authoring). Release action: Bump pyproject.toml version 26.8.23 -> 26.9.22 once exact-head CI is green. The repo has no git tags, so a v26.9.22 tag is optional and follows the same authority as the other repos. The v26.9.22 orders (GYMACT-5/6/7 and hermeticity) go in the xaas v26.9.22 graph with repository=seanchatmangpt/gymact, replacing the generate.py literal that SJ-008 used. Commit docs/jira/v26.9.19." .
sj:cp-ash-atlassian-v26922-release a sj:Checkpoint ;
    rdfs:label "local/ash_atlassian v26.9.22 release checkpoint" ;
    dcterms:description "Closes the v26.9.22 cycle for local/ash_atlassian (integration head 36b1799381d04b50da2bececd4b201defc231333 on release/v26.9.22 at authoring). Release action: Set mix.exs @version and ggen.toml to 26.9.22, run ggen sync, and tag v26.9.22. The tag stays local until a GitHub repo exists. The SJ-007 follow-up orders (OSLC CM/SIOC pin, pack extension, OpenAPI transport, relationships, ADF) are issued once in the xaas v26.9.22 graph, superseding both the sj-007 SJ-010..012 and the ARD-proposed SJ-010..014 numbering." .
sj:cp-beam4pm-v26922-release a sj:Checkpoint ;
    rdfs:label "seanchatmangpt/beam4pm v26.9.22 release checkpoint" ;
    dcterms:description "Closes the v26.9.22 cycle for seanchatmangpt/beam4pm (integration head 574368706e6afd804c7a13771bed3cf03da33ce0 on release/v26.9.22 at authoring). Release action: Use `mix beam4pm.version_bump 26.9.22 --yes` (mix.exs and src/beam4pm.app.src are at 26.9.12) and tag v26.9.22 (origin tops out at v26.9.9). Commit docs/jira/v26.9.22 following the repo's docs/jira/vX practice, with the SA2A guard receipt under receipts/. The admitted work orders live in the xaas v26.9.22 graph with repository=seanchatmangpt/beam4pm, because pinned ggen_igniter hex 26.9.15 has no SemanticJira until GGEN_IGNITER-26922-13 ships." .
sj:cp-frozen-duckdb-v26922-release a sj:Checkpoint ;
    rdfs:label "seanchatmangpt/frozen-duckdb v26.9.22 release checkpoint" ;
    dcterms:description "Closes the v26.9.22 cycle for seanchatmangpt/frozen-duckdb (integration head 3ebfac8c62c3fdf14275bdff737074079731234e on release/v26.9.22 at authoring). Release action: The product version is semver 1.5.5 (Cargo workspace), so there is no CalVer tag. The v1.5.5 tag and crates.io publish are operator steps, retargeted to post-merge master. The v26.9.22 cycle becomes docs/sjira/v26.9.22 as admitted work orders (index.json + wo.json + generated tickets), replacing the bash SPECS heredoc generators. docs/sjira/v26.9.21 stays as history, with frontmatter reconciled." .
sj:cp-ggen-ecosystem-v26922-release a sj:Checkpoint ;
    rdfs:label "seanchatmangpt/ggen-ecosystem v26.9.22 release checkpoint" ;
    dcterms:description "Closes the v26.9.22 cycle for seanchatmangpt/ggen-ecosystem (integration head 435117fd7f419cc18b0d7b1ba3f25c2d224ac1fc on release/v26.9.22 at authoring). Release action: Follow the v26.9.17 practice: set ecosystem.lock.toml [ggen].release and [container].tag to v26.9.22, add a CHANGELOG entry, tag v26.9.22, publish the GHCR image, and write receipts/release-v26.9.22-container.json. Pin producers only to commits on their default branches, because the crown resets gitlinks. No docs/sjira folder; the work orders go in the xaas v26.9.22 graph, and docs/jira/v26.9.18/19 are committed." .
sj:cp-ash-surface-v26922-release a sj:Checkpoint ;
    rdfs:label "seanchatmangpt/ash_surface v26.9.22 release checkpoint" ;
    dcterms:description "Closes the v26.9.22 cycle for seanchatmangpt/ash_surface (integration head 9972ef6a8e105cfad0c6feb5c2ac3adf02fcb058 on release/v26.9.22 at authoring). Release action: scripts/bump_version.sh 26.9.22 is the only lawful bump: it moves the lib carriers and goldens together. Tag v26.9.22, the repo's first tag, only on a green exact-HEAD PR. The v26.9.22 orders (v26.9.19 001-004 plus v26.9.17 016/026/050) go in the xaas v26.9.22 graph with repository=seanchatmangpt/ash_surface. Commit the untracked docs/jira/v26.9.19 after correcting the stale cleanup-merge-plan.md." .
sj:cp-ferroplan-v26922-release a sj:Checkpoint ;
    rdfs:label "seanchatmangpt/ferroplan v26.9.22 release checkpoint" ;
    dcterms:description "Closes the v26.9.22 cycle for seanchatmangpt/ferroplan (integration head 305546927ebef3b188e79b2f497f8360f998f44b on release/v26.9.22 at authoring). Release action: The engine uses semver (workspace 0.28.0; fork tag v0.28.0 at 17e38bb collides with upstream's imminent 0.28.0), so there is no CalVer tag. After the upstream merge, either bump to 0.28.1 or rename, as the user decides. The v26.9.22 cycle is committed as docs/jira/v26.9.22 in the repo's own style, and the admitted orders go in the xaas v26.9.22 graph (repository=seanchatmangpt/ferroplan). The consumer pin work is ASH_A2A-26922-09." .
sj:cp-gitvan-v26922-release a sj:Checkpoint ;
    rdfs:label "seanchatmangpt/gitvan v26.9.22 release checkpoint" ;
    dcterms:description "Closes the v26.9.22 cycle for seanchatmangpt/gitvan (integration head a905abdb0baad27357b7a5c46ca31253a10c1fb9 on release/v26.9.22 at authoring). Release action: The package uses semver (4.0.1), so there is no CalVer tag. Align VERSION and package.json, then tag v4.0.1 (or the next patch) on a green main. The v26.9.22 cycle is committed as docs/jira/v26.9.22 in repo style, and the orders go in the xaas v26.9.22 graph (repository=seanchatmangpt/gitvan), since gitvan's SA2A role is as the xaas FrontierEvidence producer." .
sj:cp-chatman-ecosystem-v26922-release a sj:Checkpoint ;
    rdfs:label "local/chatman-ecosystem v26.9.22 release checkpoint" ;
    dcterms:description "Closes the v26.9.22 cycle for local/chatman-ecosystem (integration head 7ac66d8c55ce4aba62cd6416e9f3eecd358700e4 on release/v26.9.22 at authoring). Release action: This repo has no version manifest and no remote, so there is no tag. The cycle ends with committing the doc refresh and the path-collision decision. Do not merge the unrelated GitHub namesake, whose draft PRs #250-#252 belong to that lineage." .

# ---- GGEN_IGNITER-26922-01 ----
sj:wo-ggen-igniter-26922-01
    a sj:WorkOrder ;
    rdfs:label "GGEN_IGNITER-26922-01: Sync refs: fetch the 6 missing heads and fast-forward local main" ;
    dcterms:identifier "GGEN_IGNITER-26922-01" ;
    dcterms:title "Sync refs: fetch the 6 missing heads and fast-forward local main" ;
    dcterms:description "Sync refs: fetch the 6 missing heads and fast-forward local main. Acceptance: `cd /Users/sac/ggen_igniter && git fetch origin && git fetch origin main:main && git merge-base --is-ancestor origin/main main && for s in f283790 e20c552 3edd2ec 775d0f3 8032dab 186c74c; do git cat-file -e $s^{commit} || echo MISSING $s; done` prints nothing." ;
    sj:repository "seanchatmangpt/ggen_igniter" ;
    sj:baseSha "facdf0dbd3cd95f5b8a630dcbcacc0140d6582fc" ;
    sj:subject "seanchatmangpt/ggen_igniter@release/v26.9.22#GGEN_IGNITER-26922-01" ;
    sj:standing "UNKNOWN" ;
    sj:evidenceCeiling "EXECUTED_VERIFIED" ;
    sj:authorityCeiling "CONSTRUCT" ;
    sj:authorityRequirement "NONE" ;
    sj:promotionRule "GGEN_IGNITER-26922-01 leaves UNKNOWN only through a TransitionLog event whose receipt binds candidateSha and subjectSha on seanchatmangpt/ggen_igniter release/v26.9.22 descended from facdf0dbd3cd95f5b8a630dcbcacc0140d6582fc: the court must observe the acceptance check pass at that head, observe it fail when the order's diff is reverted (revert-mutation), and find every upstream edge (none) ALIVE. A passing log without a receipt, a generated projection, or upstream standing alone never promotes." ;
    sj:replayIdentity "semantic-jira:v26.9.22:GGEN_IGNITER-26922-01" ;
    sj:pathScope "." ;
    sj:requiresReceiptClass "manufacture", "verification", "replay", "postcondition" ;
    sj:requiresCourt sj:court-ggen-igniter-26922-01 ;
    sj:requiresEvidence sj:source-evidence, sj:local-execution-evidence, sj:receipt-evidence, sj:replay-evidence, sj:postcondition-evidence ;
    sj:acceptance sj:acc-ggen-igniter-26922-01-check, sj:acc-ggen-igniter-26922-01-subject ;
    sj:falsifier sj:fal-ggen-igniter-26922-01-outcome, sj:fal-ggen-igniter-26922-01-mutation ;
    sj:projection sj:projection-jira, sj:projection-sa2a, sj:projection-worker, sj:projection-verification, sj:projection-machine, sj:projection-receipt, sj:projection-replay ;
    sj:nextAction sj:act-ggen-igniter-26922-01-court ;
    sj:nextCheckpoint sj:cp-ggen-igniter-v26922-release .

sj:court-ggen-igniter-26922-01 a sj:Court ;
    rdfs:label "GGEN_IGNITER-26922-01 exact-head court" ;
    dcterms:description "Independent court for GGEN_IGNITER-26922-01 (seanchatmangpt/ggen_igniter): re-runs the acceptance check against the release/v26.9.22 integration head in /Users/sac/wt/v26922/ggen_igniter/int, applies a revert-mutation of the order diff that must make the check fail, applies the doctrine lens, and writes /Users/sac/wt/v26922/court/ggen_igniter/GGEN_IGNITER-26922-01.json binding candidateSha, subjectSha, toolchain and receipt identity." .
sj:acc-ggen-igniter-26922-01-check a sj:AcceptanceCriterion ;
    rdfs:label "GGEN_IGNITER-26922-01 runnable check" ;
    dcterms:description "`cd /Users/sac/ggen_igniter && git fetch origin && git fetch origin main:main && git merge-base --is-ancestor origin/main main && for s in f283790 e20c552 3edd2ec 775d0f3 8032dab 186c74c; do git cat-file -e $s^{commit} || echo MISSING $s; done` prints nothing" .
sj:acc-ggen-igniter-26922-01-subject a sj:AcceptanceCriterion ;
    rdfs:label "GGEN_IGNITER-26922-01 exact-subject binding" ;
    dcterms:description "The check runs at a recorded head of seanchatmangpt/ggen_igniter release/v26.9.22 that has facdf0dbd3cd95f5b8a630dcbcacc0140d6582fc as an ancestor (git merge-base --is-ancestor facdf0dbd3cd HEAD exits 0); that head is the receipt subjectSha." .
sj:fal-ggen-igniter-26922-01-outcome a sj:Falsifier ;
    rdfs:label "GGEN_IGNITER-26922-01 check refuted" ;
    dcterms:description "Refutes GGEN_IGNITER-26922-01: at the court head, the check prints any line or match (for example a MISSING/STALE marker)." .
sj:fal-ggen-igniter-26922-01-mutation a sj:Falsifier ;
    rdfs:label "GGEN_IGNITER-26922-01 vacuous acceptance" ;
    dcterms:description "Refutes the acceptance of GGEN_IGNITER-26922-01 as evidence: after reverting only the order diff on the court head, the same check still passes, so it does not observe this order consequence." .
sj:act-ggen-igniter-26922-01-court a sj:Action ;
    rdfs:label "Run the GGEN_IGNITER-26922-01 court" ;
    dcterms:description "Take /Users/sac/wt/v26922/ggen_igniter/.merge.lock per COORDINATION.md, build in an own worktree off release/v26.9.22 (facdf0dbd3cd), run the acceptance check, write receipts/v26.9.22/GGEN_IGNITER-26922-01.json (validate_receipt.py) and the court verdict, then append the standing transition to the TransitionLog." .

