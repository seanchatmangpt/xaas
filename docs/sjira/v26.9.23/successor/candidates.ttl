    sj:sourceText "the ggen-sync-check verifier runs ggen sync --check in a clean worktree\nof the episode subject and exits non-zero whenever a generated file differs from what ggen\nsync renders." ;
    sj:boundaryClass sj:Core ;
    sj:requiredBy v23:GC24-1 ;
    sj:consequenceClass "verification" ;
    sj:exclusion "Episode drift commits are never made on friday/gc-fri-0800 or main." ;
    sj:exclusion "The repair never publishes to a registry (no hex, crates, npm, GHCR or Homebrew publish)." ;
    sj:exclusion "The repair uses no network access beyond ggen pack fetch." ;
    sj:requiresCapability "recipe:ggen-sync" ;
    sj:candidateStanding "UNKNOWN" ;
