@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Exact contained demo subject. This is a semantic/demo entity, not evidence
# that a real financial transaction occurred.

chi:purchase-001
    a prov:Entity ;
    dcterms:identifier "urn:chicago:agentic-payment:purchase-001" ;
    rdfs:label "Chicago Agentic Payment purchase-001" ;
    dcterms:description "Contained Agentic Payments episode used to test requirement, semantic admission, delegated capability, planning, execution, process evidence, standing and human projection across the ecosystem." ;
    dcterms:isPartOf chi:GC-XAAS-26.10.1-CHICAGO .

# Candidate-only cases. These are acceptance/falsifier scenarios, never
# observations, receipts, authority or standing. A renderer may display them
# before any runtime execution because their observed standing is UNKNOWN.

chi:case-authorized-bounded
    a sj:Prediction, prov:Entity ;
    dcterms:identifier "CHI-CASE-001" ;
    rdfs:label "Bounded authorized purchase" ;
    dcterms:description "A bounded purchase with valid identity and delegation is the positive path; execution/ALIVE must still be established by the owning runtime/evidence courts." ;
    sj:subject "urn:chicago:agentic-payment:purchase-001" ;
    sj:candidateOnly true ;
    sj:authorityClaim "NONE" ;
    sj:observedStanding "UNKNOWN" .

chi:case-over-limit
    a sj:Prediction, prov:Entity ;
    dcterms:identifier "CHI-CASE-002" ;
    rdfs:label "Amount exceeds delegated limit" ;
    dcterms:description "The requested amount exceeds the admitted delegated limit and must produce a typed refusal with no protected DO." ;
    sj:subject "urn:chicago:agentic-payment:purchase-001" ;
    sj:candidateOnly true ;
    sj:authorityClaim "NONE" ;
    sj:observedStanding "UNKNOWN" .

chi:case-wrong-principal
    a sj:Prediction, prov:Entity ;
    dcterms:identifier "CHI-CASE-003" ;
    rdfs:label "Wrong principal" ;
    dcterms:description "The principal does not match the delegated authority subject and must be refused before protected DO." ;
    sj:subject "urn:chicago:agentic-payment:purchase-001" ;
    sj:candidateOnly true ;
    sj:authorityClaim "NONE" ;
    sj:observedStanding "UNKNOWN" .

chi:case-expired-delegation
    a sj:Prediction, prov:Entity ;
    dcterms:identifier "CHI-CASE-004" ;
    rdfs:label "Expired delegation" ;
    dcterms:description "An expired delegation is stale authority and must be refused rather than refreshed implicitly." ;
    sj:subject "urn:chicago:agentic-payment:purchase-001" ;
    sj:candidateOnly true ;
    sj:authorityClaim "NONE" ;
    sj:observedStanding "UNKNOWN" .

chi:case-provider-unavailable
    a sj:Prediction, prov:Entity ;
    dcterms:identifier "CHI-CASE-005" ;
    rdfs:label "Provider unavailable before dispatch" ;
    dcterms:description "Pre-dispatch provider unavailability preserves other admitted realizations and may trigger bounded replanning without changing authority." ;
    sj:subject "urn:chicago:agentic-payment:purchase-001" ;
    sj:candidateOnly true ;
    sj:authorityClaim "NONE" ;
    sj:observedStanding "UNKNOWN" .

chi:case-unknown-after-dispatch
    a sj:Prediction, prov:Entity ;
    dcterms:identifier "CHI-CASE-006" ;
    rdfs:label "Unknown after dispatch" ;
    dcterms:description "A timeout or disconnect after dispatch is UNKNOWN_AFTER_DISPATCH; reconcile the original consequence and never blind replay." ;
    sj:subject "urn:chicago:agentic-payment:purchase-001" ;
    sj:candidateOnly true ;
    sj:authorityClaim "NONE" ;
    sj:observedStanding "UNKNOWN" .

chi:case-missing-evidence
    a sj:Prediction, prov:Entity ;
    dcterms:identifier "CHI-CASE-007" ;
    rdfs:label "Missing evidence cannot promote standing" ;
    dcterms:description "A consequence may be claimed or inferred, but absent the required exact-subject evidence and receipt the layer cannot promote to ALIVE." ;
    sj:subject "urn:chicago:agentic-payment:purchase-001" ;
    sj:candidateOnly true ;
    sj:authorityClaim "NONE" ;
    sj:observedStanding "UNKNOWN" .

chi:case-stale-subject
    a sj:Prediction, prov:Entity ;
    dcterms:identifier "CHI-CASE-008" ;
    rdfs:label "Stale or mismatched subject" ;
    dcterms:description "A receipt, plan or evidence object bound to a different subject or stale semantic identity is refused rather than generalized." ;
    sj:subject "urn:chicago:agentic-payment:purchase-001" ;
    sj:candidateOnly true ;
    sj:authorityClaim "NONE" ;
    sj:observedStanding "UNKNOWN" .

chi:case-policy-drift
    a sj:Prediction, prov:Entity ;
    dcterms:identifier "CHI-CASE-009" ;
    rdfs:label "Semantic policy drift invalidates stale plan" ;
    dcterms:description "When relevant semantic/policy premises change, a stale plan loses applicability and the planner must re-enter bounded selection/replanning." ;
    sj:subject "urn:chicago:agentic-payment:purchase-001" ;
    sj:candidateOnly true ;
    sj:authorityClaim "NONE" ;
    sj:observedStanding "UNKNOWN" .

chi:case-surface-no-authority
    a sj:Prediction, prov:Entity ;
    dcterms:identifier "CHI-CASE-010" ;
    rdfs:label "Human projection cannot mint authority" ;
    dcterms:description "Operator, buyer, seller and engineer views may differ in presentation but none may grant DO or change the exact semantic subject/evidence." ;
    sj:subject "urn:chicago:agentic-payment:purchase-001" ;
    sj:candidateOnly true ;
    sj:authorityClaim "NONE" ;
    sj:observedStanding "UNKNOWN" .
