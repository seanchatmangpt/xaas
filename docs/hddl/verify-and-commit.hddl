;; verify-and-commit.hddl
;; Observed this session: every workflow's final "Verify" stage ran this exact
;; sequence (mix compile --force -> mix ecto.migrate -> mix test -> mock-grep ->
;; git commit -F). Written down as HDDL instead of re-derived in prose per cycle.
;;
;; Real commands each action maps to, so this stays checkable against actual repo
;; behavior rather than becoming aspirational:
;;   compile     -> mix compile --force
;;   migrate     -> mix ecto.migrate (DEV_DB_PORT from docker compose port db 5432)
;;   test        -> mix test <scoped-paths>
;;   mock-grep   -> grep -rn "unittest.mock\|Mock(\|MagicMock\|patch(\|monkeypatch\|Mox\b\|:meck\|meck\." <paths>
;;   commit      -> git add -A && git commit -F <msg-file>  (never -m, per tools.md)

(define (domain verify-and-commit)
  (:requirements :hierarchy :typing :negative-preconditions)

  (:types
    repo - object
    change-set - object
  )

  (:predicates
    (edited ?r - repo ?c - change-set)
    (compiled ?r - repo)
    (compile-clean ?r - repo)
    (migrated ?r - repo)
    (migrations-applied ?r - repo)   ;; real migrations ran this pass
    (migrations-noop ?r - repo)      ;; "Migrations already up" -- valid terminal state
    (tested ?r - repo)
    (tests-green ?r - repo)
    (mock-checked ?r - repo)
    (mock-clean ?r - repo)
    (status-checked ?r - repo)
    (has-changes ?r - repo ?c - change-set)     ;; git status --porcelain non-empty
    (nothing-to-commit ?r - repo)               ;; git status --porcelain empty -- valid no-op
    (committed ?r - repo ?c - change-set)
    (verify-only-complete ?r - repo)            ;; no-op run reached a valid terminal state
    (pushed ?r - repo ?c - change-set)
  )

  ;; ---- compound tasks ----
  (:task VERIFY-AND-COMMIT
    :parameters (?r - repo ?c - change-set)
  )

  (:task finalize
    :parameters (?r - repo ?c - change-set)
  )

  ;; Per this repo's Operating Mode (CLAUDE.md): a red/incomplete result does
  ;; NOT block the commit -- it blocks the CLAIM of "done," not the DO. Both
  ;; methods below are admissible; the honest-disclosure method is the default
  ;; because this repo is exploration-mode, not production-gated.
  (:method m-verify-then-commit-honest
    :parameters (?r - repo ?c - change-set)
    :task (VERIFY-AND-COMMIT ?r ?c)
    :precondition (edited ?r ?c)
    :ordered-subtasks (and
      (t1 (compile ?r))
      (t2 (migrate ?r))
      (t3 (test ?r))
      (t4 (mock-grep ?r))
      (t5 (check-git-status ?r ?c))
      (t6 (finalize ?r ?c))
    )
  )

  ;; `finalize` branches on the real status-check outcome rather than always
  ;; calling `git commit`. Both branches are admissible terminal states of
  ;; VERIFY-AND-COMMIT -- neither is an error.
  (:method m-finalize-with-changes
    :parameters (?r - repo ?c - change-set)
    :task (finalize ?r ?c)
    :precondition (has-changes ?r ?c)
    :ordered-subtasks (and (t1 (commit-with-real-status ?r ?c)))
  )

  (:method m-finalize-noop
    :parameters (?r - repo ?c - change-set)
    :task (finalize ?r ?c)
    :precondition (nothing-to-commit ?r)
    :ordered-subtasks (and (t1 (report-verify-only ?r)))
  )

  ;; ---- primitive actions ----
  ;; Each :effect only asserts what the real command's exit status actually
  ;; proves -- compiled != compile-clean; tested != tests-green. A caller must
  ;; check the clean/green predicate before claiming success in prose.

  (:action compile
    :parameters (?r - repo)
    :precondition ()
    :effect (compiled ?r)
    ;; real: (compile-clean ?r) asserted only if `mix compile --force` exits 0
    ;; with no "== Compilation error ==" block in output -- a caller must
    ;; observe this, not assume it from (compiled ?r) alone.
  )

  (:action migrate
    :parameters (?r - repo)
    :precondition (compiled ?r)
    :effect (and (migrated ?r) (oneof (migrations-applied ?r) (migrations-noop ?r)))
    ;; real: `mix ecto.migrate` exit code 0 is success in BOTH observed cases:
    ;;   - stdout contains "N migrations up" / migration file names running
    ;;     -> assert (migrations-applied ?r)
    ;;   - stdout is exactly "Migrations already up" (or equivalent no-op
    ;;     message) -> assert (migrations-noop ?r)
    ;; Both satisfy (migrated ?r) and both allow the pipeline to proceed to
    ;; `test`. Only a non-zero exit code or a printed "** (Mix)" / stacktrace
    ;; error is a real failure that should halt the pipeline.
  )

  (:action test
    :parameters (?r - repo)
    :precondition (migrated ?r)
    :effect (tested ?r)
    ;; real: (tests-green ?r) asserted only if the real "N tests, 0 failures"
    ;; line is observed -- never inferred from (tested ?r) alone.
  )

  (:action mock-grep
    :parameters (?r - repo)
    :precondition (tested ?r)
    :effect (mock-checked ?r)
    ;; real: (mock-clean ?r) asserted only if the grep returns zero matches,
    ;; or every match is a named, justified exception per
    ;; ~/.claude/rules/testing-chicago-style.md's "one legitimate use."
  )

  (:action check-git-status
    :parameters (?r - repo ?c - change-set)
    :precondition (mock-checked ?r)
    :effect (and (status-checked ?r) (oneof (has-changes ?r ?c) (nothing-to-commit ?r)))
    ;; real: `git status --porcelain`.
    ;;   - non-empty output -> assert (has-changes ?r ?c); proceed to commit.
    ;;   - empty output -> assert (nothing-to-commit ?r). This is a genuine
    ;;     no-op verify-only run (e.g. re-running verify after a prior commit,
    ;;     or a pure investigation pass with no edits) -- it is NOT a failure
    ;;     and must NOT attempt `git add -A && git commit`, which would error
    ;;     ("nothing to commit, working tree clean") or, worse, be papered
    ;;     over with an empty/fabricated commit.
  )

  (:action commit-with-real-status
    :parameters (?r - repo ?c - change-set)
    :precondition (has-changes ?r ?c)
    :effect (and (committed ?r ?c))
    ;; real: commit message states compile/test/mock-grep results as OBSERVED,
    ;; distinguishing e.g. "339 tests, 0 failures" (verified) from "not yet
    ;; re-run" (disclosed, not claimed). git commit -F <file>, never -m.
  )

  (:action report-verify-only
    :parameters (?r - repo)
    :precondition (nothing-to-commit ?r)
    :effect (verify-only-complete ?r)
    ;; real: report the pipeline's real observed results (compile/migrate/
    ;; test/mock-grep outcomes) and state explicitly "nothing to commit --
    ;; working tree clean" as the terminal state. This is success, not an
    ;; unfinished VERIFY-AND-COMMIT: there is no change-set to attach a
    ;; commit to, so (committed ?r ?c) is correctly never asserted.
  )

  (:action push
    :parameters (?r - repo ?c - change-set)
    :precondition (committed ?r ?c)
    :effect (pushed ?r ?c)
    ;; real: `git push` -- only after explicit user request or an active
    ;; standing directive (e.g. the "storm/power outage" checkpoint request
    ;; this session), per the harness's send-message-class confirmation rule
    ;; extended to "publish this commit externally."
  )
)
