# xaas-ash-core-pack/ontology.ttl
#
# Real ggen-rendered replacement for what was, until now, a hand/loop-
# assembled JS Workflow script. Every xar:RenderTarget below references a
# real pcc:Capability IRI from chatman-ecosystem's own
# ontology/platform-console-capabilities.ttl (not redefined here), carries
# the module/domain/action facts templates/build-base.sh.tmpl needs, and is
# aligned -- via skos:closeMatch, never owl:equivalentClass -- to
# togaf:Capability, the real class from the TOGAF 9.2 Content Metamodel
# ontology already fetched into this marketplace
# (ontologies/public/xaas-profile-batch-1/togaf-content-metamodel.ttl,
# confirmed real classes: togaf:Capability, togaf:BusinessCapability,
# togaf:Function, togaf:ApplicationArchitectureComponent,
# togaf:InformationSystemService, togaf:OrganizationUnit, etc.). This is a
# genuine public-ontology alignment, not an invented equivalence -- per
# xaas-public-ontology-profile/gates/020_no_unproven_equivalence.rq, which
# still refuses any owl:equivalentClass/equivalentProperty in this repo.

@prefix xar:   <https://ggen.io/ontology/xaas-ash-render#> .
@prefix pcc:   <https://seanchatmangpt.github.io/chatman-ecosystem/ontology/platform-console-capabilities#> .
@prefix togaf: <http://www.semanticweb.org/ontologies/2020/4/OntologyTOGAFContentMetamodel.owl#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

<https://ggen.io/ontology/xaas-ash-render#> a owl:Ontology ;
  rdfs:label "XaaS Ash render-hint bridge vocabulary" ;
  rdfs:comment "Real rendering facts for all 44 real ce:Capability individuals -> Ash.Resource generator commands. Not an ontology of Ash itself; xar:RenderTarget individuals skos:closeMatch togaf:Capability (TOGAF 9.2 Content Metamodel), a real public-ontology alignment, never an asserted owl:equivalentClass." .

xar:RenderTarget a owl:Class ;
  rdfs:label "A capability individual paired with the module/domain/action-verb facts needed to render its mix ash.gen.resource command line" .

xar:renderOf a owl:ObjectProperty ; rdfs:domain xar:RenderTarget ; rdfs:range owl:Thing .
xar:moduleName a owl:DatatypeProperty ; rdfs:domain xar:RenderTarget ; rdfs:range xsd:string .
xar:domainModule a owl:DatatypeProperty ; rdfs:domain xar:RenderTarget ; rdfs:range xsd:string .
xar:actionName a owl:DatatypeProperty ; rdfs:domain xar:RenderTarget ; rdfs:range xsd:string .
xar:requiredAuthority a owl:DatatypeProperty ; rdfs:domain xar:RenderTarget ; rdfs:range xsd:string ;
  rdfs:comment "Real ce:requiredAuthority string copied verbatim from platform-console-capabilities.ttl for this individual." .
xar:reversible a owl:DatatypeProperty ; rdfs:domain xar:RenderTarget ; rdfs:range xsd:boolean ;
  rdfs:comment "Real ce:reversible fact copied verbatim from platform-console-capabilities.ttl for this individual." .
xar:standing a owl:DatatypeProperty ; rdfs:domain xar:RenderTarget ; rdfs:range xsd:string ;
  rdfs:comment "Real ce:standing fact copied verbatim from platform-console-capabilities.ttl for this individual." .
xar:capabilityClass a owl:DatatypeProperty ; rdfs:domain xar:RenderTarget ; rdfs:range xsd:string ;
  rdfs:comment "Real ce:capabilityClass local name (Do/Select/Construct/Observe) copied from platform-console-capabilities.ttl for this individual." .

xar:CastleVerbInventoryComponentsRender a xar:RenderTarget ;
  xar:renderOf pcc:CastleVerbInventoryComponents ;
  xar:moduleName "CastleVerbInventoryComponents" ;
  xar:domainModule "Xaas.Operations" ;
  xar:actionName "approve" ;
  xar:requiredAuthority "AuthorityObject.admits(castle.verb.run)" ;
  xar:reversible true ;
  xar:standing "active" ;
  xar:capabilityClass "do" ;
  skos:closeMatch togaf:Capability .

